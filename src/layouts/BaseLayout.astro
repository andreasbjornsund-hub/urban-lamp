---
import { Font } from 'astro:assets';
import { SITE } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CompareTray from '../components/phone/CompareTray.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page; Organization and WebSite are always included. */
  schema?: Record<string, unknown>[];
  ogImage?: string;
  noindex?: boolean;
  /** 'article' for guides, with their dates as article:published_time / modified_time */
  ogType?: 'website' | 'article';
  article?: { published: string; modified: string };
  /** hreflang alternates, including this page; only for pages with a translation that links back */
  alternates?: { hreflang: string; href: string }[];
}

const {
  title,
  description,
  schema = [],
  ogImage = SITE.ogImage,
  noindex = false,
  ogType = 'website',
  article,
  alternates = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;

// gtag must stay global, so this is inlined as-is rather than via define:vars (which wraps it in a function)
const analytics = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${SITE.analytics.ga4}');
(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s);j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${SITE.analytics.gtm}');`;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: `${SITE.url}/`,
      logo: `${SITE.url}/apple-touch-icon.png`,
      description: SITE.description,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.name,
      alternateName: 'intrinsicallysafephones.com',
      url: `${SITE.url}/`,
      inLanguage: 'en',
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#faf8f4" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, SITE.url).href} />)}

    <meta property="og:type" content={ogType} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.modified} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ATEX Zone 1 & 2 devices compared`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-optimized content summary" />

    <Font cssVariable="--font-franklin" preload={[{ weight: '400 700', style: 'normal' }]} />
    <Font cssVariable="--font-inter" preload={[{ weight: '400 700', style: 'normal' }]} />

    <!-- Network consent banner must load before any Google tag (Consent Mode defaults first) -->
    <script is:inline src="https://hazardousareaguide.com/consent-banner.js"></script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analytics.ga4}`}></script>
    <script is:inline set:html={analytics} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CompareTray />
    <!-- HAG network outbound-link click tracking (GA4) -->
    <script is:inline src="/assets/hag-links.js" defer></script>
  </body>
</html>
