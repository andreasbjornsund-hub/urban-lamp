---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import PhoneCard from '../../components/phone/PhoneCard.astro';
import { SITE } from '../../config/site';
import { EX_FEATURES, FEATURE_GROUPS, FORM_LABEL, phoneFacts, protectionScore } from '../../lib/phones';

const phones = await getCollection('phones');
// Photo area style on the cards. Review: ?cards=light or ?cards=dark overrides it in the browser.
const CARD_THEME: 'light' | 'dark' = 'dark';
const items = await Promise.all(
  phones.map(async (phone) => {
    const thumb = phone.data.image
      ? (await getImage({ src: phone.data.image, width: 120, height: 120, fit: 'contain', format: 'webp' })).src
      : undefined;
    return { phone, facts: phoneFacts(phone, thumb) };
  }),
);
// Default order: current phones first, then highest protection, then lightest, then name
items.sort(
  (a, b) =>
    Number(a.facts.status === 'discontinued') - Number(b.facts.status === 'discontinued') ||
    protectionScore(b.facts) - protectionScore(a.facts) ||
    (a.facts.weightG ?? 9999) - (b.facts.weightG ?? 9999) ||
    a.facts.name.localeCompare(b.facts.name),
);
const facts = items.map((i) => i.facts);
const totalCount = facts.length;

const title = 'Find Intrinsically Safe Phones: Filter & Compare Models';
const description =
  'Every ATEX and IECEx certified phone in one place. Filter by zone, gas group, temperature class and features, then compare up to four side by side.';

/* ---------- Filter definitions ---------- */
type Option = { value: string; label: string; unverified?: boolean };
type Filter = { kind: 'pills' | 'checks'; name: string; legend: string; hint?: string; options: Option[] };
const pills = (name: string, legend: string, hint: string, options: Option[]): Filter => ({
  kind: 'pills', name, legend, hint, options: [{ value: '', label: 'Any' }, ...options],
});
const checks = (name: string, legend: string, options: Option[], hint?: string): Filter => ({ kind: 'checks', name, legend, hint, options });

// Ex rating: where the phone can be used. Zones first; protection method deliberately last.
const exColumns: Filter[][] = [
  [
    pills('zone', 'Gas zone', 'Phones for a higher-risk zone also qualify.', ['0', '1', '2'].map((z) => ({ value: z, label: `Zone ${z}` }))),
    pills('dust', 'Dust zone', 'Only if combustible dust is present.', ['20', '21', '22'].map((z) => ({ value: z, label: `Zone ${z}` }))),
    pills('div', 'North America', 'Class I Division rating (NEC 500).', [
      { value: '1', label: 'Division 1' },
      { value: '2', label: 'Division 2' },
    ]),
  ],
  [
    pills('group', 'Gas group', 'IIC covers IIB and IIA.', ['IIA', 'IIB', 'IIC'].map((g) => ({ value: g, label: g }))),
    pills('temp', 'Temperature class', 'The class your site needs. Stricter classes also qualify.', ['T1', 'T2', 'T3', 'T4', 'T5', 'T6'].map((t) => ({ value: t, label: t }))),
    checks('scheme', 'Certification', [
      { value: 'atex', label: 'ATEX' },
      { value: 'iecex', label: 'IECEx' },
      { value: 'ukex', label: 'UKEX' },
    ], 'Must hold all selected certificates.'),
    checks('exf', 'Mining', EX_FEATURES.map((f) => ({ value: f.key, label: f.label })), 'Underground mining needs a Group I version.'),
    checks('prot', 'Protection method', [
      { value: 'intrinsic', label: 'Intrinsic safety (Ex i)' },
      { value: 'flameproof', label: 'Flameproof enclosure (Ex d)' },
      { value: 'combined', label: 'Increased safety + intrinsic (Ex ec ic)' },
    ]),
  ],
];

// Features: device basics, then field-worker features. Features no phone has verified yet are shown on the
// dev server (so the full set can be reviewed) and left out of the live site until the catalogue has data.
const showUnverified = import.meta.env.DEV;
const available = new Set(facts.flatMap((f) => f.features));
const brands = [...new Map(facts.map((f) => [f.brandSlug, f.brand])).entries()].sort((a, b) => a[1].localeCompare(b[1]));
const featureFilters: Filter[] = [
  checks('avail', 'Availability', [{ value: 'current', label: 'Hide discontinued models' }]),
  checks('os', 'Operating system', [
    { value: 'iOS', label: 'iOS (iPhone)' },
    { value: 'Android', label: 'Android' },
    { value: 'Other', label: 'Other / proprietary' },
  ]),
  checks('form', 'Device type', Object.entries(FORM_LABEL).map(([value, label]) => ({ value, label }))),
  checks('type', 'Phone type', [
    { value: 'dedicated', label: 'Dedicated Ex phone' },
    { value: 'ex-case', label: 'Certified Ex case' },
    { value: 'conversion', label: 'Device conversion' },
  ]),
  checks('brand', 'Brand', brands.map(([value, label]) => ({ value, label }))),
  pills('weight', 'Maximum weight', '', [
    { value: '350', label: 'Under 350 g' },
    { value: '400', label: 'Under 400 g' },
    { value: '450', label: 'Under 450 g' },
  ]),
  ...FEATURE_GROUPS.map((g) =>
    checks(
      'f',
      g.title,
      g.features
        .filter((ft) => showUnverified || available.has(ft.key))
        .map((ft) => ({ value: ft.key, label: ft.label, unverified: !available.has(ft.key) })),
    ),
  ).filter((f) => f.options.length > 0),
];

const dropdowns = [
  { id: 'ex', label: 'Ex rating', columns: exColumns, wide: false },
  { id: 'features', label: 'Features', columns: [featureFilters], wide: true },
];

const url = `${SITE.url}/phones/`;
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: facts.length,
      itemListElement: facts.map((f, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}${f.href}`, name: f.name })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Find phones', item: url },
    ],
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <section class="finder-hero" aria-labelledby="finder-title">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Find phones', href: '' }]} />
      <h1 id="finder-title">Find intrinsically safe phones</h1>
      <p class="lead">
        Every ATEX and IECEx certified phone in one place. Set the Ex rating your site needs, pick the features
        your crews rely on, then compare up to four side by side.
      </p>
    </div>
  </section>

  <!-- Filter bar: stays under the header while scrolling -->
  <div class="filter-bar" data-filter-bar>
    <div class="container filter-bar-inner">
      <form class="filter-form" data-filter-form aria-label="Filter phones">
        {dropdowns.map((dd) => (
          <div class="dd" data-dd={dd.id}>
            <button class="dd-btn" type="button" aria-expanded="false" aria-controls={`dd-${dd.id}`} data-dd-btn>
              {dd.label}
              <span class="dd-count" data-dd-count hidden></span>
              <Icon name="chevron-down" />
            </button>
            <div class:list={['dd-panel', { 'dd-wide': dd.wide }]} id={`dd-${dd.id}`} data-dd-panel hidden>
              <div class="dd-head">
                <h2 class="dd-title" tabindex="-1">{dd.label}</h2>
                <button class="dd-x" type="button" data-dd-close aria-label={`Close ${dd.label}`}><Icon name="close" /></button>
              </div>
              <div class:list={['dd-body', { 'dd-cols': dd.columns.length > 1 }]}>
                {dd.columns.map((col) => (
                  <div class="dd-col">
                    {col.map((f) => (
                      <fieldset class="filter">
                        <legend>{f.legend}</legend>
                        {f.hint && <p class="filter-hint">{f.hint}</p>}
                        {f.kind === 'pills' ? (
                          <div class="pills">
                            {f.options.map((o, i) => (
                              <label>
                                <input type="radio" name={f.name} value={o.value} checked={i === 0} />
                                <span>{o.label}{o.value && <span class="opt-count" data-count-for={`${f.name}=${o.value}`}></span>}</span>
                              </label>
                            ))}
                          </div>
                        ) : (
                          <div class="checks">
                            {f.options.map((o) => (
                              <label class:list={{ unverified: o.unverified }}>
                                <input type="checkbox" name={f.name} value={o.value} />
                                <span class="check-label">
                                  {o.label}
                                  {o.unverified && <span class="unverified-note">no verified data yet</span>}
                                </span>
                                <span class="opt-count" data-count-for={`${f.name}=${o.value}`}></span>
                              </label>
                            ))}
                          </div>
                        )}
                      </fieldset>
                    ))}
                  </div>
                ))}
              </div>
              <div class="dd-foot">
                <button class="dd-clear" type="button" data-dd-clear>Clear</button>
                <button class="btn btn-primary btn-sm" type="button" data-dd-close>
                  Show <span data-result-count>{totalCount}</span> phones
                </button>
              </div>
            </div>
          </div>
        ))}
      </form>

      <p class="results-count" aria-live="polite">
        <strong data-result-count>{totalCount}</strong> <span data-result-noun>phones</span>
      </p>

      <label class="sort">
        <span class="sort-label">Sort</span>
        <span class="sort-icon" aria-hidden="true"><Icon name="sort" /></span>
        <select data-sort aria-label="Sort phones">
          <option value="protection">Highest protection</option>
          <option value="weight">Lightest</option>
          <option value="name">Name A–Z</option>
        </select>
      </label>
    </div>
  </div>

  <section class="band band-white finder" aria-label="Phones">
    <div class="container">
      <p class="results-line" aria-live="polite"><strong data-result-count>{totalCount}</strong> <span data-result-noun>phones</span></p>
      <ul class="chips" data-chips aria-label="Active filters" hidden></ul>

      <div class="unmet-note" data-unmet-note hidden>
        <p><span data-unmet-count></span> don't meet your Ex rating requirements.</p>
        <label>
          <input type="checkbox" data-unmet-toggle />
          Show them and why
        </label>
      </div>

      <ul class="card-grid" data-grid data-card-theme={CARD_THEME}>
        {items.map(({ phone, facts: f }) => <PhoneCard phone={phone} facts={f} />)}
      </ul>
      <script is:inline>
        {
          const t = new URLSearchParams(location.search).get('cards');
          if (t === 'light' || t === 'dark') document.querySelector('[data-grid]').dataset.cardTheme = t;
        }
      </script>

      <div class="empty" data-empty hidden>
        <h2>No phones match all of these filters</h2>
        <p>Try removing a feature or loosening a requirement.</p>
        <button class="btn btn-secondary btn-sm" type="button" data-clear-all>Clear all filters</button>
      </div>
    </div>
  </section>

  <!-- Short guidance for people who don't know their requirements yet -->
  <section class="band help" aria-labelledby="help-title">
    <div class="container">
      <p class="eyebrow">Not sure what you need?</p>
      <h2 id="help-title" class="h2">Three things decide which phones you can use</h2>
      <ol class="help-grid">
        <li>
          <h3>Zone</h3>
          <p>How often an explosive atmosphere is present. Zone 0 is continuous, Zone 1 likely in normal work, Zone 2 rare and brief. Your site's area classification drawing shows this.</p>
          <a class="arrow-link" href="/guides/atex-zones-explained/">ATEX zones explained <Icon name="arrow-right" /></a>
        </li>
        <li>
          <h3>Gas group</h3>
          <p>How easily the gas ignites. IIC (hydrogen, acetylene) is the most demanding and covers IIB and IIA, so most phones are certified IIC.</p>
          <a class="arrow-link" href="/guides/gas-groups-temperature-classes/">Gas groups and temperature classes <Icon name="arrow-right" /></a>
        </li>
        <li>
          <h3>Temperature class</h3>
          <p>The hottest the phone's surface can get. It must stay below the ignition temperature of the gases on site. T6 (85 °C) is the strictest.</p>
          <a class="arrow-link" href="/guides/buying-guide/">Read the buying guide <Icon name="arrow-right" /></a>
        </li>
      </ol>
    </div>
  </section>

  <script type="application/json" id="phone-data" set:html={JSON.stringify(facts)} />
</BaseLayout>

<script>
  import { GROUP_RANK, FEATURE_LABEL, FORM_LABEL, type PhoneFacts } from '../../lib/phones';

  type Status = 'ok' | 'fail' | 'unknown';
  interface Check { status: Status; text: string }
  interface State {
    zone: string; dust: string; div: string; group: string; temp: string; weight: string;
    scheme: string[]; exf: string[]; os: string[]; f: string[]; type: string[]; prot: string[];
    form: string[]; brand: string[]; avail: string[];
  }

  const SINGLE = ['zone', 'dust', 'div', 'group', 'temp', 'weight'] as const;
  const MULTI = ['scheme', 'exf', 'os', 'f', 'type', 'prot', 'form', 'brand', 'avail'] as const;
  /** Which fields each dropdown owns (for its count badge and its Clear button) */
  const SECTIONS: Record<string, string[]> = {
    ex: ['zone', 'dust', 'div', 'group', 'temp', 'scheme', 'exf', 'prot'],
    features: ['avail', 'os', 'form', 'type', 'brand', 'weight', 'f'],
  };
  const phones = JSON.parse(document.getElementById('phone-data')!.textContent || '[]') as PhoneFacts[];
  const LABELS: Record<string, string> = {
    ...FEATURE_LABEL, ...FORM_LABEL, atex: 'ATEX', iecex: 'IECEx', ukex: 'UKEX', iOS: 'iOS', Android: 'Android',
    Other: 'Other OS', dedicated: 'Dedicated Ex phone', 'ex-case': 'Ex case', conversion: 'Conversion',
    intrinsic: 'Intrinsic safety', flameproof: 'Flameproof', combined: 'Ex ec ic', current: 'Current models only',
    ...Object.fromEntries(phones.map((p) => [p.brandSlug, p.brand])),
  };

  const form = document.querySelector<HTMLFormElement>('[data-filter-form]')!;
  const grid = document.querySelector<HTMLUListElement>('[data-grid]')!;
  const cards = new Map([...grid.querySelectorAll<HTMLLIElement>('[data-phone]')].map((li) => [li.dataset.phone!, li]));
  const defaultOrder = phones.map((p) => p.id);
  const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort]')!;
  const unmetToggle = document.querySelector<HTMLInputElement>('[data-unmet-toggle]')!;

  /* ---------- State ---------- */
  function read(): State {
    const fd = new FormData(form);
    const s = {} as State;
    SINGLE.forEach((k) => (s[k] = String(fd.get(k) ?? '')));
    MULTI.forEach((k) => (s[k] = fd.getAll(k).map(String)));
    return s;
  }

  function write(s: Partial<State>) {
    form.querySelectorAll<HTMLInputElement>('input').forEach((el) => {
      const v = s[el.name as keyof State];
      if (v === undefined) return;
      if (el.type === 'radio') el.checked = el.value === v;
      else if (el.type === 'checkbox') el.checked = (v as string[]).includes(el.value);
    });
  }

  /* ---------- Matching ---------- */
  const tnum = (t?: string) => (t ? Number(t.slice(1)) : 0);

  function requirementChecks(p: PhoneFacts, s: State): Check[] {
    const out: Check[] = [];
    if (s.zone) out.push(p.zonesGas.includes(s.zone)
      ? { status: 'ok', text: `Certified for Zone ${s.zone}` }
      : { status: 'fail', text: `Not certified for Zone ${s.zone} (${p.zoneLabel})` });
    if (s.dust) out.push(p.zonesDust.includes(s.dust)
      ? { status: 'ok', text: `Certified for Zone ${s.dust}` }
      : p.zonesDust.length
        ? { status: 'fail', text: `Not certified for Zone ${s.dust}` }
        : { status: 'unknown', text: 'No dust certification listed' });
    if (s.div) out.push(p.division && p.division <= Number(s.div)
      ? { status: 'ok', text: `Division ${p.division} rated` }
      : { status: 'fail', text: `No Division ${s.div} rating listed` });
    if (s.group) out.push(!p.gasGroup
      ? { status: 'unknown', text: 'Gas group not verified' }
      : GROUP_RANK[p.gasGroup] >= GROUP_RANK[s.group]
        ? { status: 'ok', text: `Gas group ${p.gasGroup}` }
        : { status: 'fail', text: `Gas group ${p.gasGroup}, needs ${s.group}` });
    if (s.temp) out.push(!p.tempClass
      ? { status: 'unknown', text: 'Temperature class not verified' }
      : tnum(p.tempClass) >= tnum(s.temp)
        ? { status: 'ok', text: `${p.tempClass}${p.tempClass === s.temp ? '' : `, stricter than ${s.temp}`}` }
        : { status: 'fail', text: `${p.tempClass}, needs ${s.temp} or stricter` });
    s.scheme.forEach((sc) => out.push(p.schemes.includes(sc as 'atex')
      ? { status: 'ok', text: `${LABELS[sc]} certified` }
      : { status: 'fail', text: `No ${LABELS[sc]} certificate listed` }));
    s.exf.forEach((x) => out.push(p.features.includes(x as never)
      ? { status: 'ok', text: LABELS[x] }
      : { status: 'fail', text: `No ${LABELS[x].charAt(0).toLowerCase()}${LABELS[x].slice(1)} listed` }));
    if (s.prot.length) out.push(p.protection && s.prot.includes(p.protection)
      ? { status: 'ok', text: LABELS[p.protection] }
      : { status: 'fail', text: p.protection ? `${LABELS[p.protection]} protection` : 'Protection method not verified' });
    return out;
  }

  function meetsPreferences(p: PhoneFacts, s: State): boolean {
    if (p.status === 'discontinued' && s.avail.includes('current')) return false;
    if (s.os.length && !s.os.includes(p.os)) return false;
    if (s.form.length && !s.form.includes(p.formFactor)) return false;
    if (s.brand.length && !s.brand.includes(p.brandSlug)) return false;
    if (s.f.some((x) => !p.features.includes(x as never))) return false;
    if (s.weight && !(p.weightG && p.weightG <= Number(s.weight))) return false;
    if (s.type.length && !s.type.includes(p.type)) return false;
    return true;
  }

  const meets = (p: PhoneFacts, s: State) =>
    meetsPreferences(p, s) && requirementChecks(p, s).every((c) => c.status === 'ok');

  /* ---------- Rendering ---------- */
  const esc = (t: string) => t.replace(/[&<>]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[ch]!);

  function render() {
    const s = read();
    const showUnmet = unmetToggle.checked;
    let matched = 0;
    let unmet = 0;

    for (const p of phones) {
      const card = cards.get(p.id)!;
      const checks = requirementChecks(p, s);
      const reqOk = checks.every((c) => c.status === 'ok');
      const prefOk = meetsPreferences(p, s);
      if (prefOk && reqOk) matched++;
      if (prefOk && !reqOk) unmet++;
      const visible = prefOk && (reqOk || showUnmet);
      card.hidden = !visible;
      card.classList.toggle('is-unmet', visible && !reqOk);

      const list = card.querySelector<HTMLUListElement>('[data-req]')!;
      list.hidden = checks.length === 0;
      list.classList.toggle('has-fail', !reqOk);
      list.setAttribute('aria-label', reqOk ? 'Meets your requirements' : 'Does not meet your requirements');
      list.innerHTML = checks.map((c) => `<li class="${c.status}">${esc(c.text)}</li>`).join('');
    }

    sort(new Set(phones.filter((p) => !meets(p, s)).map((p) => p.id)));
    renderCounts(s);
    renderChips(s);
    renderDropdownCounts(s);

    document.querySelectorAll('[data-result-count]').forEach((el) => (el.textContent = String(matched)));
    document.querySelectorAll('[data-result-noun]').forEach((el) => (el.textContent = matched === 1 ? 'phone' : 'phones'));
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = matched > 0 || (showUnmet && unmet > 0);

    document.querySelector<HTMLElement>('[data-unmet-note]')!.hidden = unmet === 0;
    document.querySelector('[data-unmet-count]')!.textContent = `${unmet} ${unmet === 1 ? 'phone' : 'phones'}`;

    syncUrl(s);
  }

  /** Phones that meet the requirements always come before the dimmed ones */
  function sort(unmetIds: Set<string>) {
    const by = sortSelect.value;
    const list = [...phones];
    if (by === 'weight') list.sort((a, b) => (a.weightG ?? 9999) - (b.weightG ?? 9999) || a.name.localeCompare(b.name));
    else if (by === 'name') list.sort((a, b) => a.name.localeCompare(b.name));
    else list.sort((a, b) => defaultOrder.indexOf(a.id) - defaultOrder.indexOf(b.id));
    list.sort((a, b) => Number(unmetIds.has(a.id)) - Number(unmetIds.has(b.id)));
    list.forEach((p) => grid.append(cards.get(p.id)!));
  }

  /** Each option shows how many phones would match if it were chosen, given the other filters */
  function renderCounts(s: State) {
    document.querySelectorAll<HTMLElement>('[data-count-for]').forEach((el) => {
      const [name, value] = el.dataset.countFor!.split('=');
      const next: State = { ...s, [name]: (MULTI as readonly string[]).includes(name)
        ? [...new Set([...(s[name as (typeof MULTI)[number]]), value])]
        : value };
      const n = phones.filter((p) => meets(p, next)).length;
      el.textContent = String(n);
      el.closest('label')!.classList.toggle('is-zero', n === 0);
    });
  }

  function activeIn(s: State, fields: string[]) {
    return fields.reduce((n, k) => {
      const v = s[k as keyof State];
      return n + (Array.isArray(v) ? v.length : v ? 1 : 0);
    }, 0);
  }

  function renderDropdownCounts(s: State) {
    document.querySelectorAll<HTMLElement>('[data-dd]').forEach((dd) => {
      const n = activeIn(s, SECTIONS[dd.dataset.dd!]);
      const badge = dd.querySelector<HTMLElement>('[data-dd-count]')!;
      badge.hidden = n === 0;
      badge.textContent = String(n);
      dd.classList.toggle('is-active', n > 0);
    });
  }

  function renderChips(s: State) {
    const chips: { label: string; clear: Partial<State> }[] = [];
    if (s.zone) chips.push({ label: `Zone ${s.zone}`, clear: { zone: '' } });
    if (s.dust) chips.push({ label: `Zone ${s.dust}`, clear: { dust: '' } });
    if (s.div) chips.push({ label: `Division ${s.div}`, clear: { div: '' } });
    if (s.group) chips.push({ label: `Gas group ${s.group}`, clear: { group: '' } });
    if (s.temp) chips.push({ label: `${s.temp} or stricter`, clear: { temp: '' } });
    if (s.weight) chips.push({ label: `Under ${s.weight} g`, clear: { weight: '' } });
    MULTI.forEach((k) => s[k].forEach((v) => chips.push({ label: LABELS[v] ?? v, clear: { [k]: s[k].filter((x) => x !== v) } })));

    const ul = document.querySelector<HTMLUListElement>('[data-chips]')!;
    ul.hidden = chips.length === 0;
    ul.innerHTML = chips
      .map((c, i) => `<li><button type="button" data-chip="${i}">${esc(c.label)}<span aria-hidden="true">×</span><span class="visually-hidden"> remove filter</span></button></li>`)
      .join('') + (chips.length > 1 ? '<li><button type="button" class="chip-clear" data-clear-all>Clear all</button></li>' : '');
    ul.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((b) =>
      b.addEventListener('click', () => {
        write(chips[Number(b.dataset.chip)].clear);
        render();
      }),
    );
  }

  /* ---------- URL: filters are shareable; the compare tray manages ?compare= itself ---------- */
  function syncUrl(s: State) {
    const url = new URL(location.href);
    SINGLE.forEach((k) => (s[k] ? url.searchParams.set(k, s[k]) : url.searchParams.delete(k)));
    MULTI.forEach((k) => (s[k].length ? url.searchParams.set(k, s[k].join(',')) : url.searchParams.delete(k)));
    sortSelect.value !== 'protection' ? url.searchParams.set('sort', sortSelect.value) : url.searchParams.delete('sort');
    unmetToggle.checked ? url.searchParams.set('unmet', '1') : url.searchParams.delete('unmet');
    history.replaceState(null, '', url);
  }

  function loadUrl() {
    const q = new URLSearchParams(location.search);
    const s: Partial<State> = {};
    SINGLE.forEach((k) => q.has(k) && (s[k] = q.get(k)!));
    MULTI.forEach((k) => q.has(k) && (s[k] = q.get(k)!.split(',')));
    write(s);
    if (q.get('sort')) sortSelect.value = q.get('sort')!;
    unmetToggle.checked = q.get('unmet') === '1';
  }

  function clearFields(fields: string[]) {
    const empty: Partial<State> = {};
    fields.forEach((k) => ((empty as Record<string, unknown>)[k] = (MULTI as readonly string[]).includes(k) ? [] : ''));
    write(empty);
    render();
  }

  form.addEventListener('change', render);
  sortSelect.addEventListener('change', render);
  unmetToggle.addEventListener('change', render);
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-clear-all]')) {
      unmetToggle.checked = false;
      clearFields([...SINGLE, ...MULTI]);
    }
  });

  /* ---------- Dropdowns: popovers on desktop, bottom sheets on mobile ---------- */
  const dds = [...document.querySelectorAll<HTMLElement>('[data-dd]')];
  const mobile = matchMedia('(max-width: 47.99rem)');

  function setOpen(dd: HTMLElement, open: boolean, returnFocus = false) {
    const btn = dd.querySelector<HTMLButtonElement>('[data-dd-btn]')!;
    const panel = dd.querySelector<HTMLElement>('[data-dd-panel]')!;
    btn.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    dd.classList.toggle('is-open', open);
    const anyOpen = dds.some((d) => d.classList.contains('is-open'));
    document.documentElement.classList.toggle('dd-sheet-open', anyOpen && mobile.matches);
    if (open && mobile.matches) {
      panel.setAttribute('role', 'dialog');
      panel.setAttribute('aria-modal', 'true');
      panel.setAttribute('aria-label', btn.textContent!.trim());
      panel.querySelector<HTMLElement>('.dd-title')!.focus();
    } else if (!open) {
      panel.removeAttribute('role');
      panel.removeAttribute('aria-modal');
    }
    if (!open && returnFocus) btn.focus();
  }

  dds.forEach((dd) => {
    const btn = dd.querySelector<HTMLButtonElement>('[data-dd-btn]')!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      dds.forEach((d) => d !== dd && setOpen(d, false));
      setOpen(dd, open);
    });
    dd.querySelectorAll('[data-dd-close]').forEach((b) => b.addEventListener('click', () => setOpen(dd, false, true)));
    dd.querySelector('[data-dd-clear]')!.addEventListener('click', () => clearFields(SECTIONS[dd.dataset.dd!]));
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dd.classList.contains('is-open')) {
        e.stopPropagation();
        setOpen(dd, false, true);
      }
    });
  });

  // Close on a click outside (desktop popovers; the mobile backdrop is outside too)
  document.addEventListener('pointerdown', (e) => {
    dds.forEach((dd) => {
      if (dd.classList.contains('is-open') && !dd.contains(e.target as Node)) setOpen(dd, false);
    });
  });
  mobile.addEventListener('change', () => dds.forEach((d) => setOpen(d, false)));

  loadUrl();
  render();
</script>

