---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntries, getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import MarkingDecoder from '../../components/phone/MarkingDecoder.astro';
import ZoneCoverage from '../../components/phone/ZoneCoverage.astro';
import CompareTable from '../../components/phone/CompareTable.astro';
import { SITE, MAIN_NAV, CONTACT } from '../../config/site';
import { externalLink, pageSlug } from '../../lib/links';
import {
  TYPE_LABEL,
  TYPE_EXPLAINER,
  FORM_LABEL,
  TEMP_CLASS_MAX,
  zoneLabel,
  confirmedDivision,
  schemeList,
  monthYear,
  type Phone,
} from '../../lib/phones';

export const getStaticPaths = (async () => {
  const phones = await getCollection('phones');
  return phones.map((phone) => ({ params: { slug: phone.id }, props: { phone } }));
}) satisfies GetStaticPaths;

const { phone } = Astro.props as { phone: Phone };
const d = phone.data;
const c = d.certification;
const s = d.specs;
const os = d.os;
const safety = d.safety;
const url = `${SITE.url}/phones/${phone.id}/`;
const utmContent = pageSlug(Astro.url.pathname);

const alternatives = (await getEntries(d.alternatives.map((id) => ({ collection: 'phones' as const, id })))).filter(Boolean) as Phone[];
const successor = d.successor ? await getEntry('phones', d.successor) : undefined;
const discontinued = d.status === 'discontinued';

/* ---------- Unconfirmed values: each distinct note is numbered in page order ---------- */
const notes: string[] = [];
function flag(...keys: string[]): number | undefined {
  const text = keys.map((k) => d.unconfirmed[k]).find(Boolean);
  if (!text) return undefined;
  if (!notes.includes(text)) notes.push(text);
  return notes.indexOf(text) + 1;
}

interface Row { label: string; value?: string; flag?: number }
/** A labelled value; the flag is only registered when the value is shown */
const row = (label: string, value: string | undefined, ...keys: string[]): Row => ({
  label,
  value,
  flag: value ? flag(...keys) : undefined,
});
const yn = (v: boolean | undefined) => (v === undefined ? undefined : v ? 'Yes' : 'No');

/* ---------- Copy built from the data ---------- */
const zones = zoneLabel(phone);
const division = confirmedDivision(phone);
const schemes = schemeList(phone);
const updates = monthYear(os.securityUntil);
const updatesEstimated = Boolean(d.unconfirmed['os.securityUntil']);
const markingConfirmed = !(d.unconfirmed['certification.atex.marking'] && !c.atex?.number && !c.iecex?.number);
// Only a marking backed by a certificate is quoted in the description and FAQ
const headline = markingConfirmed ? (c.atex?.marking.split(' / ')[0] ?? c.iecex?.marking.split(' / ')[0] ?? c.note) : undefined;
const typeLower = TYPE_LABEL[d.type].charAt(0).toLowerCase() + TYPE_LABEL[d.type].slice(1);
const titleOptions = [`${d.name}: ${zones} Specs & Alternatives`, `${d.name}: Specs & Alternatives`, `${d.name} Specs`];
const title = titleOptions.find((t) => t.length <= 60) ?? d.name;
const description = clip(
  `${d.name} by ${d.manufacturer.name}: ${typeLower} ${markingConfirmed ? 'certified' : 'rated'} for ${zones}${headline ? ` (${headline})` : ''}. Certification decoded, full specs and the closest alternatives compared.`,
  160,
);

function clip(text: string, max: number) {
  if (text.length <= max) return text;
  return text.slice(0, text.lastIndexOf(' ', max - 1)).replace(/[,:;(]$/, '') + '…';
}

// Built in page order, so the note numbers run in sequence down the page
const atAGlance = [
  row('Certified for', zones),
  row('Protection', c.protection ?? c.note),
  row('Temperature class', c.tempClass ? `${c.tempClass} (≤ ${TEMP_CLASS_MAX[c.tempClass]} °C)` : undefined),
  row('Ambient temperature', c.ambient, 'certification.ambient'),
  row('Operating system', os.version, 'os.version'),
  row('Security updates', updates ? `Until ${updates}` : undefined, 'os.securityUntil'),
  row('Weight', s.weightG ? `${s.weightG} g` : undefined, 'specs.weightG'),
  row('Price', 'On request'),
].filter((g) => g.value);

const atexFlag = c.atex ? flag('certification.atex.marking') : undefined;
const iecexFlag = c.iecex ? flag('certification.iecex.marking') : undefined;

const safetyRows = [
  row('Ambient temperature (Ta)', c.ambient, 'certification.ambient'),
  row('Charging', safety.charging),
  row('Battery swap', safety.batterySwap),
  row('IP code in the Ex certificate', s.exIp, 'specs.exIp'),
  row('Operating temperature', s.operatingTemp, 'specs.operatingTemp'),
].filter((r) => r.value);
const conditionsFlag = safety.conditions ? flag('safety.conditions') : undefined;
const hasSafety = safetyRows.length > 0 || Boolean(safety.conditions);

const caseWord = d.type === 'ex-case' ? 'case' : 'housing';
const specRows = (keys: (keyof typeof s)[], labels: Record<string, string>) =>
  keys.map((k) => row(labels[k], typeof s[k] === 'string' ? (s[k] as string) : undefined, `specs.${k}`));

const specGroups = [
  {
    title: 'Certification',
    rows: [
      row('ATEX marking', c.atex?.marking, 'certification.atex.marking'),
      row('ATEX certificate', c.atex?.number ?? c.atex?.scope),
      row('IECEx marking', c.iecex?.marking, 'certification.iecex.marking'),
      row('IECEx certificate', c.iecex ? [c.iecex.number, c.iecex.scope && `(${c.iecex.scope})`].filter(Boolean).join(' ') : undefined),
      row('UKEX certificate', c.ukex),
      row('Other approvals', c.otherSchemes.join('; ') || undefined, 'certification.otherSchemes'),
      row('North America', c.northAmerica, 'certification.northAmerica'),
      row('Protection level (EPL)', c.epl),
      row('Dust group', c.dustGroup),
      row('Max surface temperature (dust)', c.maxSurfaceTemp),
      row('Standards', c.standards.join(', ') || undefined),
    ],
  },
  {
    title: 'Device',
    rows: [
      row('Type', TYPE_LABEL[d.type]),
      row('Device type', FORM_LABEL[d.formFactor]),
      row('Phone inside', d.hostDevice),
      row('Launched', d.launchYear?.toString()),
      row('Part numbers', s.partNumbers),
      row('Operating system', os.version, 'os.version'),
      row('OS at launch', os.atLaunch),
      row('OS upgrades', os.upgradeLimit),
      row('Security updates', updates ? `Until ${updates}` : undefined, 'os.securityUntil'),
      ...specRows(['chip', 'ram', 'storage'], { chip: 'Processor', ram: 'Memory (RAM)', storage: 'Storage' }),
    ],
  },
  ...(d.throughCase.length
    ? [{
        title: `What works through the ${caseWord}`,
        rows: d.throughCase.map((t) => row(t.label, t.value, `throughCase.${t.label}`)),
      }]
    : []),
  ...(d.capabilities.length
    ? [{
        title: 'Field capabilities',
        rows: d.capabilities.map((t) => row(t.label, t.value, `capabilities.${t.label}`)),
      }]
    : []),
  {
    title: 'Display and camera',
    rows: specRows(['display', 'resolution', 'refreshRate', 'brightness', 'touch', 'camera', 'frontCamera', 'video'], {
      display: 'Display', resolution: 'Resolution', refreshRate: 'Refresh rate', brightness: 'Brightness', touch: 'Touch',
      camera: 'Rear camera', frontCamera: 'Front camera', video: 'Video',
    }),
  },
  {
    title: 'Connectivity',
    rows: specRows(['network', 'bands', 'wifi', 'bluetooth', 'nfc', 'gnss', 'sim', 'uwb', 'satellite'], {
      network: 'Network', bands: 'Bands', wifi: 'Wi-Fi', bluetooth: 'Bluetooth', nfc: 'NFC', gnss: 'Satellite positioning',
      sim: 'SIM', uwb: 'Ultra Wideband', satellite: 'Satellite features',
    }),
  },
  {
    title: 'Physical and power',
    rows: [
      row('Weight', s.weightG ? `${s.weightG} g${s.weightNote ? ` (${s.weightNote.toLowerCase()})` : ''}` : undefined, 'specs.weightG'),
      row('Dimensions', s.dimensionsMm ? `${s.dimensionsMm} mm` : undefined, 'specs.dimensionsMm'),
      ...specRows(['ipRating', 'ruggedness', 'battery', 'batteryLife'], {
        ipRating: 'Ingress protection', ruggedness: 'Ruggedness', battery: 'Battery', batteryLife: 'Battery life',
      }),
      row('Replaceable battery', yn(s.replaceableBattery)),
      ...specRows(['port', 'wirelessCharging'], { port: 'Port', wirelessCharging: 'Wireless charging' }),
    ],
  },
  {
    title: 'Controls',
    rows: [
      ...specRows(['keys'], { keys: 'Keys' }),
      row('Push-to-talk key', yn(s.pttKey)),
      row('Glove touch', yn(s.gloveTouch)),
      ...specRows(['biometrics', 'depthSensing', 'accessories'], {
        biometrics: 'Biometrics', depthSensing: 'Depth sensing', accessories: 'Accessory interface',
      }),
    ],
  },
  {
    title: 'Fleet and support',
    rows: [
      row('Device management', os.enterprise),
      row('Preinstalled apps', s.apps, 'specs.apps'),
      row('Manufacturer', `${d.manufacturer.name}, ${d.manufacturer.country}`),
    ],
  },
]
  .map((g) => ({ ...g, rows: g.rows.filter((r) => r.value) }))
  .filter((g) => g.rows.length);

const useCaseLabel = new Map(
  (MAIN_NAV.find((i) => i.label === 'Best for')?.menu ?? []).flatMap((g) => g.links).map((l) => [l.href, l.label]),
);
const bestFor = d.bestFor.map((slug) => ({ href: `/best/${slug}/`, label: useCaseLabel.get(`/best/${slug}/`) ?? slug }));

/* ---------- FAQ ---------- */
const inZone0 = c.zonesGas.includes('0');
const certifiedWord = markingConfirmed ? 'certified' : `rated, according to ${d.brand}'s published data,`;
const protectionKind = c.protection?.split(' ')[0];
const protectionAnswer =
  protectionKind === 'Flameproof'
    ? `It uses a flameproof enclosure (Ex db), a form of explosion-proof protection. The housing is built to contain an ignition inside it and stop the flame reaching the surrounding atmosphere.`
    : protectionKind === 'Increased'
      ? `It combines increased safety (Ex ec) with intrinsic safety (Ex ic), both suited to Zone 2. Increased safety adds measures against sparks and hot surfaces; intrinsic safety limits the energy in the circuits.`
      : protectionKind === 'Intrinsic'
        ? `It is intrinsically safe: ${c.protection!.charAt(0).toLowerCase()}${c.protection!.slice(1)}. Intrinsic safety limits the electrical and thermal energy in the device below the level that could ignite the surrounding atmosphere.`
        : undefined;

const faqs = [
  {
    q: `Is the ${d.name} certified for Zone 1?`,
    a: c.zonesGas.includes('1')
      ? `Yes. The ${d.name} is ${certifiedWord} for ${zones}${headline ? ` with the marking ${headline}` : ''}. Equipment certified for Zone 1 can also be used in Zone 2.`
      : `No. It is ${certifiedWord} for ${zones} only, so it can be used in Zone 2 but not in Zone 1.`,
  },
  {
    q: `Can the ${d.name} be used in Zone 0?`,
    a: inZone0
      ? `Yes. It carries protection level Ga, which Zone 0 requires.`
      : `No. It is not certified for Zone 0. Zone 0 needs equipment with protection level Ga, such as Ex ia intrinsic safety.`,
  },
  ...(protectionAnswer ? [{ q: `What type of explosion protection does the ${d.name} use?`, a: protectionAnswer }] : []),
  ...(c.tempClass
    ? [{
        q: `What does ${c.tempClass} mean for the ${d.name}?`,
        a: `Its surface stays below ${TEMP_CLASS_MAX[c.tempClass]} °C, so it is suitable for gases that only ignite above that temperature. Check the ignition temperature of the substances on your site.`,
      }]
    : []),
  ...(safety.charging
    ? [{
        q: `Can you charge the ${d.name} in a hazardous area?`,
        a: safety.chargingInZone
          ? `Yes, with conditions: ${safety.charging.charAt(0).toLowerCase()}${safety.charging.slice(1)}. Check the certificate's conditions of use before charging on site.`
          : `No. The certificate only allows charging outside the hazardous area.`,
      }]
    : []),
  ...(d.hostDevice
    ? [{ q: `Which phone is inside the ${d.name}?`, a: `A standard ${d.hostDevice}. ${TYPE_EXPLAINER[d.type]}` }]
    : []),
  {
    q: `What operating system does the ${d.name} run?`,
    a: `${os.version}.${updates ? ` Security updates ${updatesEstimated ? 'are expected until at least' : 'until'} ${updates}.` : ''}`,
  },
  ...(discontinued || d.statusNote
    ? [{
        q: `Is the ${d.name} still available?`,
        a: discontinued
          ? `No. ${d.statusNote ?? 'It has been discontinued.'}`
          : d.statusNote!,
      }]
    : []),
  {
    q: `How much does the ${d.name} cost?`,
    a: `Prices for certified hazardous-area phones depend on volume, configuration and region, so they are on request. Contact us for a price.`,
  },
];

const mfr = externalLink(d.manufacturer.website, utmContent);
const sources = d.sources.map((src) => ({ ...src, ...externalLink(src.url, utmContent) }));

/* ---------- Structured data ---------- */
const img = d.image ? await getImage({ src: d.image, width: 800, format: 'webp' }) : undefined;
const props = [
  ['Ex marking (ATEX)', c.atex?.marking],
  ['Ex marking (IECEx)', c.iecex?.marking],
  ['Hazardous area zones', zones],
  ['Gas group', c.gasGroup],
  ['Temperature class', c.tempClass],
  ['Ambient temperature', c.ambient],
  ['Operating system', os.version],
  ['Weight', s.weightG ? `${s.weightG} g` : undefined],
].filter((p): p is [string, string] => Boolean(p[1]));

const schema = [
  {
    '@type': 'Product',
    '@id': `${url}#product`,
    name: d.name,
    description: d.summary,
    category: 'Intrinsically safe and explosion-proof smartphones',
    brand: { '@type': 'Brand', name: d.brand },
    manufacturer: { '@type': 'Organization', name: d.manufacturer.name, url: d.manufacturer.website },
    ...(img && { image: new URL(img.src, SITE.url).href }),
    additionalProperty: props.map(([name, value]) => ({ '@type': 'PropertyValue', name, value })),
  },
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${url}#product` },
    dateModified: d.lastVerified.toISOString().slice(0, 10),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: 'Home', item: `${SITE.url}/` },
      { name: 'Phones', item: `${SITE.url}/phones/` },
      { name: d.name, item: url },
    ].map((b, i) => ({ '@type': 'ListItem', position: i + 1, ...b })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const verified = d.lastVerified.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const sections = [
  { id: 'overview', label: 'Overview' },
  { id: 'certification', label: 'Certification' },
  ...(hasSafety ? [{ id: 'safety', label: 'Safe use' }] : []),
  { id: 'specs', label: 'Specifications' },
  ...(alternatives.length ? [{ id: 'compare', label: 'Compare' }] : []),
  { id: 'faq', label: 'FAQ' },
];
// Bands alternate white and warm down the page, whichever optional sections are present
const bandFor = (id: string) => (sections.findIndex((sec) => sec.id === id) % 2 === 0 ? 'band-white' : 'band-warm');
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Hero -->
  <section class="phone-hero" aria-labelledby="phone-title">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Phones', href: '/phones/' }, { label: d.name, href: '' }]} />

      <div class="hero-grid">
        <div class="hero-media">
          {d.image ? (
            <Image
              src={d.image}
              alt={d.imageAlt ?? d.name}
              widths={[360, 560, 720]}
              sizes="(min-width: 56rem) 40vw, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <div class="media-placeholder" aria-hidden="true">No image yet</div>
          )}
        </div>

        <div class="hero-copy">
          <p class="eyebrow">
            <a href={`/brands/${d.brandSlug}/`}>{d.brand}</a> · {TYPE_LABEL[d.type]}
          </p>
          <h1 id="phone-title">{d.name}</h1>

          <ul class="badges" aria-label="Key certifications">
            {discontinued && <li class="badge badge-caution">Discontinued</li>}
            <li class="badge badge-strong">{zones}</li>
            {schemes.map((sc) => <li class="badge">{sc}</li>)}
            {c.gasGroup && <li class="badge">{c.gasGroup}</li>}
            {c.tempClass && <li class="badge">{c.tempClass}</li>}
            {division && <li class="badge">{division}</li>}
          </ul>

          {(discontinued || d.statusNote) && (
            <p class="status-note" role="note">
              <strong>{discontinued ? 'Discontinued.' : 'Check availability.'}</strong>{' '}
              {d.statusNote}
              {successor && (
                <>
                  {' '}<a href={`/phones/${successor.id}/`}>See the {successor.data.name}</a>
                </>
              )}
            </p>
          )}

          <p class="lead">{d.summary}</p>

          <dl class="glance">
            {atAGlance.map((g) => (
              <div>
                <dt>{g.label}</dt>
                <dd>
                  {g.value}
                  {g.flag && <a class="flag" href={`#note-${g.flag}`}>Unconfirmed<span class="visually-hidden">: see note</span> {g.flag}</a>}
                </dd>
              </div>
            ))}
          </dl>

          <div class="hero-actions">
            {discontinued && successor ? (
              <a class="btn btn-primary" href={`/phones/${successor.id}/`}>
                View the {successor.data.name} <Icon name="arrow-right" />
              </a>
            ) : (
              <a class="btn btn-primary" href={`${CONTACT.href}?phone=${phone.id}`}>
                Request a price <Icon name="arrow-right" />
              </a>
            )}
            <button class="btn btn-secondary" type="button" data-compare-add={phone.id} aria-pressed="false">
              <span class="when-off">+ Add to compare</span>
              <span class="when-on">✓ In your comparison</span>
            </button>
          </div>
          {alternatives.length > 0 && (
            <a class="arrow-link hero-alt" href="#compare">See how it compares to alternatives <Icon name="arrow-right" /></a>
          )}

          {d.sponsor && (
            <p class="sponsor-note">
              <span class="sponsor-tag">Sponsor</span>
              {d.brand} sponsors this site. Facts and comparisons follow the same rules for every phone.{' '}
              <a href="/how-we-rate/">How we rate</a>
            </p>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- In-page navigation -->
  <nav class="subnav" aria-label="On this page">
    <div class="container">
      <ul>
        {sections.map((sec) => <li><a href={`#${sec.id}`}>{sec.label}</a></li>)}
      </ul>
    </div>
  </nav>

  <!-- Overview -->
  <section id="overview" class:list={['band', bandFor('overview')]} aria-labelledby="overview-title">
    <div class="container">
      <p class="eyebrow">Overview</p>
      <h2 id="overview-title" class="h2">Strengths and limitations</h2>
      <div class="procon">
        <div class="procon-col pro">
          <h3>Strengths</h3>
          <ul>{d.strengths.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="procon-col con">
          <h3>Limitations</h3>
          <ul>{d.limitations.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>

      {bestFor.length > 0 && (
        <div class="best-for">
          <h3>Best for</h3>
          <ul>{bestFor.map((b) => <li><a href={b.href}>{b.label}</a></li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <!-- Certification -->
  <section id="certification" class:list={['band', bandFor('certification')]} aria-labelledby="cert-title">
    <div class="container">
      <div class="split-head">
        <div>
          <p class="eyebrow">Certification</p>
          <h2 id="cert-title" class="h2">Where you can use it</h2>
        </div>
        <p class="split-head-text">
          {TYPE_EXPLAINER[d.type]}
          {c.protection && ` Protection method: ${c.protection.charAt(0).toLowerCase()}${c.protection.slice(1)}.`}
        </p>
      </div>

      <ZoneCoverage phone={phone} />

      {(c.atex || c.iecex) ? (
        <div class="markings">
          <h3>The Ex marking, decoded</h3>
          {c.atex && <MarkingDecoder scheme="ATEX" marking={c.atex.marking} number={c.atex.number} scope={c.atex.scope} flag={atexFlag} />}
          {c.iecex && <MarkingDecoder scheme="IECEx" marking={c.iecex.marking} number={c.iecex.number} scope={c.iecex.scope} flag={iecexFlag} />}
        </div>
      ) : (
        <p class="marking-missing">
          The full Ex marking for this product isn't in our verified data yet. Listed certification: {c.note}.
        </p>
      )}

      {d.variants.length > 0 && (
        <div class="variants">
          <h3>Versions</h3>
          <ul>
            {d.variants.map((v) => (
              <li>
                <p class="variant-name">{v.name}</p>
                <p>{v.description}</p>
                {(v.marking || v.certificates || v.partNumber) && (
                  <dl class="variant-facts">
                    {v.marking && <div><dt>Marking</dt><dd><code>{v.marking}</code></dd></div>}
                    {v.certificates && <div><dt>Certificates</dt><dd>{v.certificates}</dd></div>}
                    {v.partNumber && <div><dt>Part number</dt><dd>{v.partNumber}</dd></div>}
                  </dl>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- Safe use -->
  {hasSafety && (
    <section id="safety" class:list={['band', bandFor('safety')]} aria-labelledby="safety-title">
      <div class="container">
        <div class="split-head">
          <div>
            <p class="eyebrow">Safe use</p>
            <h2 id="safety-title" class="h2">Rules for the hazardous area</h2>
          </div>
          <p class="split-head-text">
            What the certificate allows, and where. Always follow the certificate and the manufacturer's safety
            instructions for your exact model.
          </p>
        </div>

        {safetyRows.length > 0 && (
          <dl class="safety-grid">
            {safetyRows.map((r) => (
              <div>
                <dt>{r.label}</dt>
                <dd>
                  {r.value}
                  {r.flag && <a class="flag" href={`#note-${r.flag}`}>Unconfirmed<span class="visually-hidden">: see note</span> {r.flag}</a>}
                </dd>
              </div>
            ))}
          </dl>
        )}

        {safety.conditions && (
          <div class="conditions">
            <h3>
              Conditions of use
              {conditionsFlag && <a class="flag" href={`#note-${conditionsFlag}`}>Unconfirmed<span class="visually-hidden">: see note</span> {conditionsFlag}</a>}
            </h3>
            <p>{safety.conditions}</p>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Specifications -->
  <section id="specs" class:list={['band', bandFor('specs')]} aria-labelledby="specs-title">
    <div class="container">
      <p class="eyebrow">Specifications</p>
      <h2 id="specs-title" class="h2">Full specifications</h2>
      {d.hostDevice && (
        <p class="spec-intro">
          Device specifications are for the {d.hostDevice} inside. “What works through the {caseWord}” shows which of its
          features you can use in the {caseWord}.
        </p>
      )}
      <div class="spec-grid">
        {specGroups.map((g) => (
          <div class="spec-group">
            <h3>{g.title}</h3>
            <dl>
              {g.rows.map((r) => (
                <div>
                  <dt>{r.label}</dt>
                  <dd>
                    {r.value}
                    {r.flag && <a class="flag" href={`#note-${r.flag}`}>Unconfirmed<span class="visually-hidden">: see note</span> {r.flag}</a>}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
      <p class="spec-note">
        Only specifications we could check are listed. Values marked “Unconfirmed” come from a single or secondary
        source, or sources disagree; the notes at the foot of the page explain each one. See the{' '}
        <a href={mfr.href} rel={mfr.rel} target={mfr.target}>{d.manufacturer.name} website</a> for the full data sheet.
      </p>
    </div>
  </section>

  <!-- Compare -->
  {alternatives.length > 0 && (
    <section id="compare" class:list={['band', bandFor('compare')]} aria-labelledby="compare-title">
      <div class="container">
        <div class="split-head">
          <div>
            <p class="eyebrow">Compare</p>
            <h2 id="compare-title" class="h2">How it compares</h2>
          </div>
          <p class="split-head-text">
            The closest alternatives to the {d.name}, side by side. Turn on “Show differences only” to see what sets them apart.
          </p>
        </div>
        <CompareTable phones={[phone, ...alternatives]} caption={`${d.name} compared with its closest alternatives`} />
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section id="faq" class:list={['band', bandFor('faq')]} aria-labelledby="faq-title">
    <div class="container faq-wrap">
      <div>
        <p class="eyebrow">FAQ</p>
