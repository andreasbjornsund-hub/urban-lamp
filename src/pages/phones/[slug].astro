---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntries } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import MarkingDecoder from '../../components/phone/MarkingDecoder.astro';
import ZoneCoverage from '../../components/phone/ZoneCoverage.astro';
import CompareTable from '../../components/phone/CompareTable.astro';
import { SITE, MAIN_NAV, CONTACT } from '../../config/site';
import { externalLink, pageSlug } from '../../lib/links';
import { TYPE_LABEL, TYPE_EXPLAINER, TEMP_CLASS_MAX, zoneLabel, topZone, type Phone } from '../../lib/phones';

export const getStaticPaths = (async () => {
  const phones = await getCollection('phones');
  return phones.map((phone) => ({ params: { slug: phone.id }, props: { phone } }));
}) satisfies GetStaticPaths;

const { phone } = Astro.props as { phone: Phone };
const d = phone.data;
const c = d.certification;
const s = d.specs;
const url = `${SITE.url}/phones/${phone.id}/`;
const utmContent = pageSlug(Astro.url.pathname);

const alternatives = (await getEntries(d.alternatives.map((id) => ({ collection: 'phones' as const, id })))).filter(Boolean) as Phone[];

/* ---------- Copy built from the data ---------- */
const zones = zoneLabel(phone);
const headline = c.atex?.marking.split(' / ')[0] ?? c.iecex?.marking.split(' / ')[0] ?? c.note;
const titleOptions = [`${d.name}: ${zones} Specs & Alternatives`, `${d.name}: Specs & Alternatives`, `${d.name} Specs`];
const title = titleOptions.find((t) => t.length <= 60) ?? d.name;
const description = clip(
  `${d.name} by ${d.manufacturer.name}: ${TYPE_LABEL[d.type].toLowerCase()} certified for ${zones}${headline ? ` (${headline})` : ''}. Certification decoded, full specs and the closest alternatives compared.`,
  160,
);

function clip(text: string, max: number) {
  if (text.length <= max) return text;
  return text.slice(0, text.lastIndexOf(' ', max - 1)).replace(/[,:;(]$/, '') + '…';
}

const atAGlance = [
  { label: 'Certified for', value: zones },
  { label: 'Protection', value: c.protection ?? c.note ?? '—' },
  { label: 'Temperature class', value: c.tempClass ? `${c.tempClass} (≤ ${TEMP_CLASS_MAX[c.tempClass]} °C)` : '—' },
  { label: 'Operating system', value: d.os.version },
  { label: 'Weight', value: s.weightG ? `${s.weightG} g` : '—' },
  { label: 'Price', value: 'On request' },
].filter((g) => g.value !== '—');

const specGroups = [
  {
    title: 'Certification',
    rows: [
      ['ATEX marking', c.atex?.marking],
      ['ATEX certificate', c.atex?.number],
      ['IECEx marking', c.iecex?.marking],
      ['IECEx certificate', c.iecex?.number],
      ['Other schemes', c.otherSchemes.join(', ') || undefined],
      ['North America', c.division],
      ['Ambient temperature', c.ambient],
      ['Standards', c.standards.join(', ') || undefined],
    ],
  },
  {
    title: 'Device',
    rows: [
      ['Type', TYPE_LABEL[d.type]],
      ['Phone inside', d.hostDevice],
      ['Operating system', d.os.version],
      ['Software updates', d.os.updates],
      ['Display', s.display],
      ['Processor', s.chip],
      ['Camera', s.camera],
      ['Storage', s.storage],
      ['Connectivity', s.connectivity?.join(', ')],
    ],
  },
  {
    title: 'Physical',
    rows: [
      ['Weight', s.weightG ? `${s.weightG} g${s.weightNote ? ` (${s.weightNote.toLowerCase()})` : ''}` : undefined],
      ['Dimensions', s.dimensionsMm ? `${s.dimensionsMm} mm` : undefined],
      ['Ingress protection', s.ipRating],
      ['Ruggedness', s.ruggedness],
      ['Battery', s.battery],
      ['Charging', s.charging],
      ['Replaceable battery', s.replaceableBattery === undefined ? undefined : s.replaceableBattery ? 'Yes' : 'No'],
      ['Push-to-talk key', s.pttKey === undefined ? undefined : s.pttKey ? 'Yes' : 'No'],
      ['Glove touch', s.gloveTouch === undefined ? undefined : s.gloveTouch ? 'Yes' : 'No'],
    ],
  },
  {
    title: 'Fleet and support',
    rows: [
      ['Device management', s.mdm?.join(', ')],
      ['Manufacturer', `${d.manufacturer.name}, ${d.manufacturer.country}`],
    ],
  },
]
  .map((g) => ({ ...g, rows: g.rows.filter((r): r is [string, string] => Boolean(r[1])) }))
  .filter((g) => g.rows.length);

const useCaseLabel = new Map(
  (MAIN_NAV.find((i) => i.label === 'Best for')?.menu ?? []).flatMap((g) => g.links).map((l) => [l.href, l.label]),
);
const bestFor = d.bestFor.map((slug) => ({ href: `/best/${slug}/`, label: useCaseLabel.get(`/best/${slug}/`) ?? slug }));

const inZone0 = c.zonesGas.includes('0');
const faqs = [
  {
    q: `Is the ${d.name} certified for Zone 1?`,
    a: c.zonesGas.includes('1')
      ? `Yes. The ${d.name} is certified for ${zones}${headline ? ` with the marking ${headline}` : ''}. Equipment certified for Zone 1 can also be used in Zone 2.`
      : `No. It is certified for ${zones}.`,
  },
  {
    q: `Can the ${d.name} be used in Zone 0?`,
    a: inZone0
      ? `Yes. It carries an ${c.epl ?? 'Ga'} protection level, which is required for Zone 0.`
      : `No. It is not certified for Zone 0. Zone 0 needs equipment with protection level Ga, such as Ex ia intrinsic safety.`,
  },
  ...(c.tempClass
    ? [{
        q: `What does ${c.tempClass} mean for the ${d.name}?`,
        a: `Its surface stays below ${TEMP_CLASS_MAX[c.tempClass]} °C, so it is safe in gases that only ignite above that temperature. Check the ignition temperature of the substances on your site.`,
      }]
    : []),
  ...(d.hostDevice
    ? [{ q: `Which phone is inside the ${d.name}?`, a: `${d.hostDevice}. ${TYPE_EXPLAINER[d.type]}` }]
    : []),
  { q: `What operating system does the ${d.name} run?`, a: `${d.os.version}.${d.os.updates ? ` Updates: ${d.os.updates}.` : ''}` },
  {
    q: `How much does the ${d.name} cost?`,
    a: `Prices for certified hazardous-area phones depend on volume, configuration and region, so they are on request. Contact us for a price.`,
  },
];

const mfr = externalLink(d.manufacturer.website, utmContent);
const sources = d.sources.map((src) => ({ ...src, ...externalLink(src.url, utmContent) }));

/* ---------- Structured data ---------- */
const img = d.image ? await getImage({ src: d.image, width: 800, format: 'webp' }) : undefined;
const props = [
  ['Ex marking (ATEX)', c.atex?.marking],
  ['Ex marking (IECEx)', c.iecex?.marking],
  ['Hazardous area zones', zones],
  ['Gas group', c.gasGroup],
  ['Temperature class', c.tempClass],
  ['Operating system', d.os.version],
  ['Weight', s.weightG ? `${s.weightG} g` : undefined],
].filter((p): p is [string, string] => Boolean(p[1]));

const schema = [
  {
    '@type': 'Product',
    '@id': `${url}#product`,
    name: d.name,
    description: d.summary,
    category: 'Intrinsically safe and explosion-proof smartphones',
    brand: { '@type': 'Brand', name: d.brand },
    manufacturer: { '@type': 'Organization', name: d.manufacturer.name, url: d.manufacturer.website },
    ...(img && { image: new URL(img.src, SITE.url).href }),
    additionalProperty: props.map(([name, value]) => ({ '@type': 'PropertyValue', name, value })),
  },
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${url}#product` },
    dateModified: d.lastVerified.toISOString().slice(0, 10),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: 'Home', item: `${SITE.url}/` },
      { name: 'Phones', item: `${SITE.url}/phones/` },
      { name: d.name, item: url },
    ].map((b, i) => ({ '@type': 'ListItem', position: i + 1, ...b })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const verified = d.lastVerified.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const sections = [
  { id: 'overview', label: 'Overview' },
  { id: 'certification', label: 'Certification' },
  { id: 'specs', label: 'Specifications' },
  ...(alternatives.length ? [{ id: 'compare', label: 'Compare' }] : []),
  { id: 'faq', label: 'FAQ' },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Hero -->
  <section class="phone-hero" aria-labelledby="phone-title">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Phones', href: '/phones/' }, { label: d.name, href: '' }]} />

      <div class="hero-grid">
        <div class="hero-media">
          {d.image ? (
            <Image
              src={d.image}
              alt={d.imageAlt ?? d.name}
              widths={[360, 560, 720]}
              sizes="(min-width: 56rem) 40vw, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <div class="media-placeholder" aria-hidden="true">No image yet</div>
          )}
        </div>

        <div class="hero-copy">
          <p class="eyebrow">
            <a href={`/brands/${d.brandSlug}/`}>{d.brand}</a> · {TYPE_LABEL[d.type]}
          </p>
          <h1 id="phone-title">{d.name}</h1>

          <ul class="badges" aria-label="Key certifications">
            <li class="badge badge-strong">{zones}</li>
            {c.atex && <li class="badge">ATEX</li>}
            {c.iecex && <li class="badge">IECEx</li>}
            {c.gasGroup && <li class="badge">{c.gasGroup}</li>}
            {c.tempClass && <li class="badge">{c.tempClass}</li>}
            {c.division && <li class="badge">{c.division}</li>}
          </ul>

          <p class="lead">{d.summary}</p>

          <dl class="glance">
            {atAGlance.map((g) => (
              <div>
                <dt>{g.label}</dt>
                <dd>{g.value}</dd>
              </div>
            ))}
          </dl>

          <div class="hero-actions">
            <a class="btn btn-primary" href={`${CONTACT.href}?phone=${phone.id}`}>
              Request a price <Icon name="arrow-right" />
            </a>
            <button class="btn btn-secondary" type="button" data-compare-add={phone.id} aria-pressed="false">
              <span class="when-off">+ Add to compare</span>
              <span class="when-on">✓ In your comparison</span>
            </button>
          </div>
          {alternatives.length > 0 && (
            <a class="arrow-link hero-alt" href="#compare">See how it compares to alternatives <Icon name="arrow-right" /></a>
          )}

          {d.sponsor && (
            <p class="sponsor-note">
              <span class="sponsor-tag">Sponsor</span>
              {d.brand} sponsors this site. Facts and comparisons follow the same rules for every phone.{' '}
              <a href="/how-we-rate/">How we rate</a>
            </p>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- In-page navigation -->
  <nav class="subnav" aria-label="On this page">
    <div class="container">
      <ul>
        {sections.map((sec) => <li><a href={`#${sec.id}`}>{sec.label}</a></li>)}
      </ul>
    </div>
  </nav>

  <!-- Overview -->
  <section id="overview" class="band band-white" aria-labelledby="overview-title">
    <div class="container">
      <p class="eyebrow">Overview</p>
      <h2 id="overview-title" class="h2">Strengths and limitations</h2>
      <div class="procon">
        <div class="procon-col pro">
          <h3>Strengths</h3>
          <ul>{d.strengths.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="procon-col con">
          <h3>Limitations</h3>
          <ul>{d.limitations.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>

      {bestFor.length > 0 && (
        <div class="best-for">
          <h3>Best for</h3>
          <ul>{bestFor.map((b) => <li><a href={b.href}>{b.label}</a></li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <!-- Certification -->
  <section id="certification" class="band band-warm" aria-labelledby="cert-title">
    <div class="container">
      <div class="split-head">
        <div>
          <p class="eyebrow">Certification</p>
          <h2 id="cert-title" class="h2">Where you can use it</h2>
        </div>
        <p class="split-head-text">
          {TYPE_EXPLAINER[d.type]}
          {c.protection && ` It uses ${c.protection.charAt(0).toLowerCase()}${c.protection.slice(1)}.`}
        </p>
      </div>

      <ZoneCoverage phone={phone} />

      {(c.atex || c.iecex) ? (
        <div class="markings">
          <h3>The Ex marking, decoded</h3>
          {c.atex && <MarkingDecoder scheme="ATEX" marking={c.atex.marking} number={c.atex.number} />}
          {c.iecex && <MarkingDecoder scheme="IECEx" marking={c.iecex.marking} number={c.iecex.number} />}
        </div>
      ) : (
        <p class="marking-missing">
          The full Ex marking for this product isn't in our verified data yet. Listed certification: {c.note}.
        </p>
      )}
    </div>
  </section>

  <!-- Specifications -->
  <section id="specs" class="band band-white" aria-labelledby="specs-title">
    <div class="container">
      <p class="eyebrow">Specifications</p>
      <h2 id="specs-title" class="h2">Full specifications</h2>
      <div class="spec-grid">
        {specGroups.map((g) => (
          <div class="spec-group">
            <h3>{g.title}</h3>
            <dl>
              {g.rows.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
      <p class="spec-note">
        Only verified specifications are listed. See the{' '}
        <a href={mfr.href} rel={mfr.rel} target={mfr.target}>{d.manufacturer.name} website</a> for the full data sheet.
      </p>
    </div>
  </section>

  <!-- Compare -->
  {alternatives.length > 0 && (
    <section id="compare" class="band band-warm" aria-labelledby="compare-title">
      <div class="container">
        <div class="split-head">
          <div>
            <p class="eyebrow">Compare</p>
            <h2 id="compare-title" class="h2">How it compares</h2>
          </div>
          <p class="split-head-text">
            The closest alternatives to the {d.name}, side by side. Turn on “Show differences only” to see what sets them apart.
          </p>
        </div>
        <CompareTable phones={[phone, ...alternatives]} caption={`${d.name} compared with its closest alternatives`} />
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section id="faq" class="band band-white" aria-labelledby="faq-title">
    <div class="container faq-wrap">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title" class="h2">Common questions</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Sources -->
  <section class="band sources" aria-labelledby="sources-title">
    <div class="container">
      <h2 id="sources-title" class="sources-title">Sources and verification</h2>
      <p>
        Facts last verified on <time datetime={d.lastVerified.toISOString().slice(0, 10)}>{verified}</time> against:
      </p>
      <ul>
        {sources.map((src) => (
          <li><a href={src.href} rel={src.rel} target={src.target}>{src.label}</a></li>
        ))}
      </ul>
      <p class="sources-note">
        Always check the certificate for your exact model before use. Spotted an error?{' '}
        <a href={CONTACT.href}>Tell us</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Highlight the in-page nav link for the section in view
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.subnav a')].map((a) => [a.hash.slice(1), a]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get(e.target.id)?.setAttribute('aria-current', 'true');
      });
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  links.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>

<style>
  /* Jump links clear the sticky header and in-page nav */
  :global(html) { scroll-padding-top: calc(var(--header-h) + 4rem); }

  /* ---------- Hero ---------- */
  .phone-hero { padding-block: 0.5rem 3rem; }

  .hero-grid {
    display: grid;
    gap: 2rem;
    margin-top: 1rem;
  }

  .hero-media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--color-panel);
    border: 1px solid var(--color-panel-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .hero-media img,
  .media-placeholder {
    position: absolute;
    inset: 1.25rem;
    width: calc(100% - 2.5rem);
    height: calc(100% - 2.5rem);
    object-fit: contain;
  }
  .media-placeholder {
    display: grid;
    place-items: center;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .hero-copy .eyebrow a { color: inherit; }
  .hero-copy h1 {
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-hero);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .badge {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .badge-strong {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-on-dark);
  }

  .hero-copy .lead { margin-top: 1.25rem; }

  .glance {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 1.75rem 0 0;
    border-top: 1px solid var(--color-panel-border);
  }
  .glance div {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--color-panel-border);
  }
  .glance dt { font-size: var(--text-xs); color: var(--color-muted); }
  .glance dd { margin: 0.15rem 0 0; font-weight: 600; color: var(--color-ink); font-size: var(--text-sm); }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .hero-alt { margin-top: 0.75rem; }

  .sponsor-note {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .sponsor-note a { color: var(--color-forest); }
  .sponsor-tag {
    display: inline-block;
    margin-right: 0.5rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  /* ---------- Sticky in-page nav ---------- */
  .subnav {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: rgb(250 248 244 / 0.92);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--color-panel-border);
  }
  .subnav ul {
    display: flex;
    gap: 1.75rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .subnav a {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .subnav a:hover { color: var(--color-ink); }
  .subnav a[aria-current] { color: var(--color-forest); border-bottom-color: var(--color-forest); }

  /* ---------- Shared section heads ---------- */
  .split-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.25rem;
  }
  .split-head-text { max-width: 30rem; font-size: var(--text-sm); }

  /* ---------- Overview ---------- */
  .procon {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .procon-col {
    padding: 1.5rem;
    border: 1px solid var(--color-panel-border);
    border-radius: var(--radius);
  }
  .procon-col h3 { font-size: var(--text-h3); margin-bottom: 1rem; }
  .procon-col ul { display: grid; gap: 0.75rem; }
  .procon-col li {
    position: relative;
    padding-left: 1.75rem;
    font-size: var(--text-sm);
    color: var(--color-ink);
  }
  .procon-col li::before {
    position: absolute;
    left: 0;
    top: 0.05rem;
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    font-size: 0.7rem;
    font-weight: 700;
  }
  .pro li::before { content: '+'; background: var(--color-icon-bg); color: var(--color-forest); }
  .con li::before { content: '–'; background: var(--color-panel-warm); color: var(--color-muted); }

  .best-for { margin-top: 2rem; }
  .best-for h3 {
    margin-bottom: 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0;
  }
  .best-for ul { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .best-for a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-ink);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .best-for a:hover { border-color: var(--color-forest); color: var(--color-forest); }

  /* ---------- Certification ---------- */
  .markings { display: grid; gap: 1rem; margin-top: 2.5rem; }
  .markings h3 { font-size: var(--text-h3); }
  .marking-missing { margin-top: 2rem; font-size: var(--text-sm); }

  /* ---------- Specs ---------- */
  .spec-grid {
    display: grid;
    gap: 1.25rem 3rem;
    margin-top: 2rem;
  }
  .spec-group h3 {
    padding-bottom: 0.6rem;
