---
import { getCollection } from 'astro:content';
import { guidePage } from '../data/guide-pages';
import { guideImage } from '../lib/guide-images';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import HeroMarquee from '../components/home/HeroMarquee.astro';
import { SITE, FIND_PHONES, CONTACT, BEST_BY_INDUSTRY } from '../config/site';
import { logo, logoScale } from '../lib/brand-logos';
import { BEST_PAGES, bestPage } from '../data/best-pages';
import { COMPARE_PAGES } from '../data/compare-pages';

// Placeholder images cropped from the design mockup. Replace with full-resolution originals.
import rigImg from '../assets/home/hero-rig.webp';
import zoneImg from '../assets/home/tab-zone.webp';
import industriesImg from '../assets/home/tab-industry.webp';
import useCaseImg from '../assets/home/tab-use-case.webp';

/* Counts and names come from the phone data, so the copy stays true as the catalogue changes */
const phones = await getCollection('phones');
const current = phones.filter((p) => p.data.status === 'current');
const phoneById = new Map(phones.map((p) => [p.id, p]));
const bestHref = (slug: string) => {
  if (!bestPage(slug)) throw new Error(`Home page links to a missing Best for page: ${slug}`);
  return `/best/${slug}/`;
};
/** Link text from the page's own h1, so it matches what the page ranks for: "Best Zone 1 phones in 2026" -> "Best Zone 1 phones" */
const bestLabel = (slug: string) => bestPage(slug)!.h1.replace(/ in \d{4}$/, '').replace(/ for hazardous areas$/, '');

const title = 'Intrinsically Safe Phones Compared: ATEX Zone 1 & 2';
const description = `Compare ${phones.length} intrinsically safe and explosion-proof phones for ATEX and IECEx zones. Head-to-heads and the best phone for every zone, industry and need.`;
if (title.length > 60 || description.length > 160) throw new Error('Home page title or description is too long');

/* ---------- Best for: three tabs ---------- */
const coversGas = (z: string) => current.filter((p) => p.data.certification.zonesGas.includes(z)).length;
const zones: { slug: string; text: string; count?: number }[] = [
  { slug: 'zone-0-phones', text: 'Gas present continuously, such as inside tanks', count: coversGas('0') },
  { slug: 'zone-1-phones', text: 'Gas likely in normal operation', count: coversGas('1') },
  { slug: 'zone-2-phones', text: 'Gas unlikely, and only briefly', count: coversGas('2') },
  { slug: 'division-1-phones', text: 'North American hazardous locations' },
];

const INDUSTRY_TEXT: Record<string, string> = {
  'oil-and-gas': 'Wellheads, refineries and terminals',
  offshore: 'Platforms and process modules',
  'chemical-processing': 'Reactors and tank farms',
  pharmaceutical: 'Solvents and powder handling',
  manufacturing: 'Paint lines and dust areas',
  utilities: 'Biogas and gas networks',
};
const industries = BEST_BY_INDUSTRY.links.map((l) => {
  const slug = l.href.split('/')[2];
  return { slug, text: INDUSTRY_TEXT[slug] };
});

const useCases: { icon: IconName; slug: string; text: string }[] = [
  { icon: 'smartphone', slug: 'iphone', text: 'Certified cases and conversions' },
  { icon: 'radio', slug: 'push-to-talk', text: 'Hardware PTT and alarm keys' },
  { icon: 'signal', slug: '5g', text: 'Bands, Wi-Fi and private networks' },
  { icon: 'camera', slug: 'camera', text: 'Inspection photos and video' },
  { icon: 'feather', slug: 'lightest', text: 'Weighed as carried' },
  { icon: 'calendar', slug: 'long-term-value', text: 'Update support and service life' },
];

const tabs = [
  { id: 'zone', label: 'Zone' },
  { id: 'industry', label: 'Industry' },
  { id: 'use-case', label: 'Use case' },
];

/* ---------- Brands: every maker's logo in its own colours (black where there's no colour file), alphabetical ---------- */
// Tile-size tweaks: i.safe's thin "MOBILE" type reads small; BARTEC's heavy type reads large
const TILE_OPTICAL: Record<string, number> = { isafe: 1.15, bartec: 0.85 };
// Xshielder's yellow logo is made for a dark surface, so it sits on its own badge, as in the hero strip
const BADGE: Record<string, string> = { xshielder: '#171B25' };
const brands = [...new Map(phones.map((p) => [p.data.brandSlug, p.data.brand])).entries()]
  .map(([slug, name]) => {
    const img = logo('brands', slug, 'colour');
    return { slug, name, img, badge: BADGE[slug], scale: img ? logoScale(slug, img) * (TILE_OPTICAL[slug] ?? 1) : 1 };
  })
  .sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));
const brandList = brands.map((b) => b.name.replace(/\s*\(.*\)$/, ''));

/* ---------- Head-to-head: one pair shown, with no sponsor product ---------- */
const FEATURED_PAIR = 'ecom-smart-ex-03-dz1-vs-isafe-is540-1';
const featured = COMPARE_PAGES.find((p) => p.slug === FEATURED_PAIR);
if (!featured) throw new Error(`Home page links to a missing comparison: ${FEATURED_PAIR}`);
const pair = await Promise.all(
  featured.phones.map(async (id) => {
    const p = phoneById.get(id)!;
    if (p.data.sponsor) throw new Error('The home page comparison must not include a sponsor product');
    const src = p.data.image
      ? (await getImage({ src: p.data.image, width: 720, height: 720, fit: 'contain', format: 'webp' })).src
      : undefined;
    return { src };
  }),
);

/* ---------- How we compare ---------- */
const principles: { icon: IconName; title: string; text: string }[] = [
  { icon: 'file-check', title: 'From the certificate', text: 'Zones, markings and limits come from certificates and maker datasheets.' },
  { icon: 'scale', title: 'Same rules for every brand', text: 'Every phone is described, ranked and compared the same way.' },
  { icon: 'flag', title: 'Unknowns flagged', text: 'Anything we could not confirm is marked as not verified, never guessed.' },
];

/* ---------- Guides: each card uses the guide's own photo (src/lib/guide-images.ts) ---------- */
const insights = ['rugged-vs-intrinsically-safe-phones', 'android-vs-iphone-hazardous-areas', 'intrinsically-safe-phone-cost'].map((slug) => {
  const page = guidePage(slug);
  const photo = guideImage(slug);
  if (!page) throw new Error(`Home page: no guide at /guides/${slug}/`);
  if (!photo) throw new Error(`Home page: no photo at src/assets/guides/${slug}.webp`);
  return { slug, ...photo, title: page.navLabel, href: `/guides/${slug}/` };
});

/* ---------- FAQ ---------- */
// Every question names its subject and every answer restates it, so each reads on its own (SEO/AEO rule).
// Facts in the copy are checked against the phone data so the answers fail the build instead of going stale.
const ios = current.filter((p) => p.data.os.name === 'iOS');
const iosZone1 = ios.filter((p) => p.data.certification.zonesGas.includes('1'));
if (iosZone1.some((p) => !p.data.certification.protection?.includes('Ex db'))) {
  throw new Error('Home FAQ says every Zone 1 iPhone option is flameproof (Ex db); re-check the copy');
}
const brandsOfType = (types: string[]) =>
  [...new Set(current.filter((p) => types.includes(p.data.type)).map((p) => p.data.brandSlug))].sort().join(',');
if (brandsOfType(['dedicated']) !== 'bartec,ecom,isafe' || brandsOfType(['ex-case', 'conversion']) !== 'atexxo,xciel,xshielder') {
  throw new Error('Home FAQ names which brands make dedicated phones and which make iPhone cases; re-check the copy');
}
const t6Zone1 = current.filter((p) => p.data.certification.zonesGas.includes('1') && p.data.certification.tempClass === 'T6');
if (t6Zone1.length === 0 || t6Zone1.some((p) => p.data.brandSlug !== 'xshielder')) {
  throw new Error('Home FAQ says only Xshielder iPhone cases are T6 among current Zone 1 phones; re-check the copy');
}
// Security update dates named in the FAQ: current Zone 1 Android smartphones, by slug
const zone1Updates = Object.fromEntries(
  current
    .filter((p) => p.data.os.name === 'Android' && p.data.formFactor === 'smartphone' && p.data.certification.zonesGas.includes('1'))
    .map((p) => [p.id, p.data.os.securityUntil]),
);
const UPDATES_IN_COPY: Record<string, string> = {
  'isafe-is530-1': '2027-03-31',
  'bartec-sp9ex1': '2030-05-31',
  'bartec-sc9ex1': '2030-05-31',
  'ecom-smart-ex-03-dz1': '2032-12-31',
  'isafe-is540-1': '2032-12-31',
  'isafe-is541-1': '2032-12-31',
};
if (JSON.stringify(Object.entries(zone1Updates).sort()) !== JSON.stringify(Object.entries(UPDATES_IN_COPY).sort())) {
  throw new Error('Home FAQ quotes security update dates for Zone 1 Android smartphones; re-check the copy');
}
const brandNames = new Intl.ListFormat('en-GB', { type: 'conjunction' }).format(brands.map((b) => b.name));
const guideHref = (slug: string) => {
  if (!guidePage(slug)) throw new Error(`Home page links to a missing guide: ${slug}`);
  return `/guides/${slug}/`;
};
const faq: { q: string; a: string; link?: { label: string; href: string } }[] = [
  {
    q: 'What is an intrinsically safe phone?',
    a: 'An intrinsically safe phone is built so its circuits and battery cannot release enough electrical or thermal energy to ignite an explosive atmosphere, even with a fault. It is certified under protection type Ex i: level ia is suitable down to Zone 0, ib down to Zone 1, and ic for Zone 2 only.',
  },
  {
    q: 'What is the difference between an intrinsically safe phone and an explosion-proof phone?',
    a: 'An intrinsically safe phone limits its energy so it cannot ignite gas or dust. An explosion-proof (flameproof, Ex db) phone or case accepts that ignition could happen inside it and contains it in a housing strong enough to stop the flame reaching the atmosphere outside, which is how every Zone 1 iPhone option we list is certified. Both methods can be approved for Zone 1, and the Ex marking shows which one a phone uses.',
  },
  {
    q: 'Is the iPhone intrinsically safe?',
    a: `No, a standard iPhone is not intrinsically safe and has no Ex certificate, so it cannot be used in a hazardous area on its own. An iPhone can be used in Zone 1 or Zone 2 inside a certified Ex case or as a certified conversion, and we list ${ios.length} current iPhone options, ${iosZone1.length} of them for Zone 1.`,
    link: { label: 'Best iPhones for hazardous areas', href: bestHref('iphone') },
  },
  {
    q: 'Which brands make intrinsically safe phones?',
    a: `The main makers of intrinsically safe and explosion-proof phones for Zone 1 and Zone 2 are ${brandNames}. BARTEC, ecom and i.safe MOBILE build dedicated intrinsically safe phones, while Atexxo, Xciel and Xshielder certify iPhones through Ex cases or conversions, and Atexxo also converts Samsung Galaxy phones.`,
    link: { label: 'See every phone we compare', href: FIND_PHONES.href },
  },
  {
    q: 'Do I need a Zone 1 or a Zone 2 phone?',
    a: 'Whether you need a Zone 1 or a Zone 2 phone depends on the most hazardous area your team enters. A Zone 1 phone can also be used in Zone 2, but a Zone 2 phone must never go into Zone 1. Check your site’s area classification drawings, and also the gas group and temperature class they call for.',
    link: { label: 'Filter phones by zone', href: FIND_PHONES.href },
  },
  {
    q: 'What temperature class does an intrinsically safe phone need?',
    a: 'Most intrinsically safe and explosion-proof phones are rated T4, so their surfaces stay at or below 135 °C, which suits most gases and vapors on industrial sites. Sites with gases that ignite below 135 °C need T5 or T6 equipment, and among the current Zone 1 phones and cases we list, only the Xshielder explosion-proof iPhone cases are rated T6.',
    link: { label: 'Best Zone 1 phones', href: bestHref('zone-1-phones') },
  },
  {
    q: 'What is the difference between ATEX, IECEx and UKEX?',
    a: 'ATEX is the legal requirement for equipment in explosive atmospheres in the EU, and UKEX is the equivalent in Great Britain. IECEx is an international certification scheme accepted in many countries outside Europe. North America uses Class and Division ratings under the NEC and CEC, so check which scheme your site needs.',
  },
  {
    q: 'Can I use a rugged phone in a hazardous area?',
    a: 'A rugged phone cannot be used in a hazardous area unless it also holds an Ex certificate such as ATEX or IECEx. Rugged ratings such as IP68 and MIL-STD-810H cover water, dust and drops, and say nothing about whether a phone can ignite gas or dust.',
    link: { label: 'Rugged vs intrinsically safe phones', href: guideHref('rugged-vs-intrinsically-safe-phones') },
  },
  {
    q: 'How much does an intrinsically safe phone cost in 2026?',
    a: 'Going by reseller list prices in October 2026, a Zone 2 intrinsically safe smartphone costs about €1,150 to €1,750 before VAT and a Zone 1 smartphone about €2,050 to €2,400, with keypad phones from around €540. Zone 1 iPhone options are usually sold with the iPhone included, so compare the full package rather than the price of the case alone.',
    link: { label: 'What intrinsically safe phones cost', href: guideHref('intrinsically-safe-phone-cost') },
  },
  {
    q: 'How long are intrinsically safe phones supported with security updates?',
    a: 'Security updates for Zone 1 intrinsically safe smartphones end between Q1 2027 for the older i.safe MOBILE IS530.1 and Q4 2032 for the ecom Smart-Ex 03 DZ1 and i.safe MOBILE IS540.1, with BARTEC’s SP9EX1 and SC9EX1 supported until May 2030. Apple publishes no end date for each iPhone, but earlier iPhones have received security updates for seven years or more.',
    link: { label: 'Best phones for long-term value', href: bestHref('long-term-value') },
  },
  {
    q: 'Which intrinsically safe phone is best?',
    a: 'The best intrinsically safe phone depends on the zone, the industry and the work. A team that needs push-to-talk, one that photographs inspections and one on a site that needs T6 equipment will each be best served by a different phone, so we rank phones for every zone, industry and use case and state the criteria behind each ranking.',
    link: { label: 'Compare phones head to head', href: '/compare/' },
  },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#webpage`,
    url: `${SITE.url}/`,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: [
      { '@type': 'Thing', name: 'Intrinsically safe phone' },
      { '@type': 'Thing', name: 'Explosion-proof phone' },
      { '@type': 'Thing', name: 'ATEX' },
    ],
    primaryImageOfPage: { '@type': 'ImageObject', url: `${SITE.url}/og-image.png` },
    mainEntity: { '@id': `${SITE.url}/#best-for` },
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE.url}/#best-for`,
    name: 'Best intrinsically safe and explosion-proof phones by zone, industry and use case',
    itemListElement: BEST_PAGES.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.h1,
      url: `${SITE.url}/best/${p.slug}/`,
    })),
  },
  {
    '@type': 'FAQPage',
    '@id': `${SITE.url}/#faq`,
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- Legacy links pointed at the old home page form (/#contact, /?inquire=…); forward them to the contact page -->
  <script is:inline>
    if (location.hash === '#contact' || new URLSearchParams(location.search).has('inquire')) {
      location.replace('/contact/' + location.search);
    }
  </script>

  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">The right phone. <span>For the right environment.</span></h1>
        <p class="lead">
          Compare certified phones for ATEX and IECEx Zone 0, 1 and 2, from intrinsically safe handsets to
          explosion-proof iPhone cases.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={FIND_PHONES.href}>{FIND_PHONES.label} <Icon name="arrow-right" /></a>
          <a class="btn btn-secondary" href="/compare/">Compare phones</a>
        </div>
      </div>
      <div class="hero-media">
        <!-- Line drawing of an offshore rig behind the strips (decorative) -->
        <div class="hero-art" aria-hidden="true">
          <Image src={rigImg} alt="" widths={[600, 900, 1200]} sizes="(min-width: 56rem) 50vw, 100vw" loading="eager" />
        </div>
        <HeroMarquee tone="colour" />
      </div>
    </div>
  </section>

  <!-- Best for: zone, industry and use case as tabs. Every panel is in the HTML (and shown without JavaScript). -->
  <section id="best-for" class="band band-white" aria-labelledby="best-title">
    <div class="container">
      <div class="search-head">
        <h2 id="best-title" class="h2">Start your search here.</h2>
        <p class="search-text">Filter by the zone, industry or use case you need, and go straight to the best phones for it.</p>
      </div>

      <div class="tabs" data-tabs>
        <div class="tab-list" role="tablist" aria-label="Find the best phone by">
          {tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={`panel-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {t.label}
            </button>
          ))}
        </div>

        <div class="tab-panel" role="tabpanel" id="panel-zone" aria-labelledby="tab-zone" tabindex="0">
          <div class="panel-media">
            <Image
              src={zoneImg}
              alt="Hand-drawn area classification: Zone 0 at a gas release, Zone 1 around it and Zone 2 beyond"
              widths={[480, 720, 960]}
              sizes="(min-width: 56rem) 28rem, 100vw"
              loading="lazy"
            />
          </div>
          <ul class="pick-list">
            {zones.map((z) => (
              <li>
                <a class="pick" href={bestHref(z.slug)}>
                  <span class="pick-body">
                    <span class="pick-title">{bestLabel(z.slug)}</span>
                    <span class="pick-text">{z.text}</span>
                  </span>
                  {z.count !== undefined && <span class="pick-count">{z.count} phones</span>}
                  <Icon name="arrow-right" class="pick-arrow" />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="tab-panel" role="tabpanel" id="panel-industry" aria-labelledby="tab-industry" tabindex="0" hidden>
          <div class="panel-media">
            <Image
              src={industriesImg}
              alt="Hand-drawn process plant with a storage tank, two distillation columns and pipework"
              widths={[480, 720, 960]}
              sizes="(min-width: 56rem) 28rem, 100vw"
              loading="lazy"
            />
          </div>
          <ul class="pick-list">
            {industries.map((i) => (
              <li>
                <a class="pick" href={bestHref(i.slug)}>
                  <span class="pick-body">
                    <span class="pick-title">{bestLabel(i.slug)}</span>
                    <span class="pick-text">{i.text}</span>
                  </span>
                  <Icon name="arrow-right" class="pick-arrow" />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="tab-panel" role="tabpanel" id="panel-use-case" aria-labelledby="tab-use-case" tabindex="0" hidden>
          <div class="panel-media">
            <Image
              src={useCaseImg}
              alt="Hand-drawn rugged phone with its camera, connectivity and weight labelled"
              widths={[480, 720, 960]}
              sizes="(min-width: 56rem) 28rem, 100vw"
              loading="lazy"
            />
          </div>
          <ul class="pick-list">
            {useCases.map((u) => (
              <li>
                <a class="pick has-icon" href={bestHref(u.slug)}>
                  <span class="pick-icon"><Icon name={u.icon} /></span>
                  <span class="pick-body">
                    <span class="pick-title">{bestLabel(u.slug)}</span>
                    <span class="pick-text">{u.text}</span>
                  </span>
                  <Icon name="arrow-right" class="pick-arrow" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <noscript>
        <style is:inline>
          .tabs .tab-list { display: none; }
          .tabs .tab-panel[hidden] { display: grid !important; margin-top: 3rem; }
        </style>
      </noscript>
    </div>
  </section>

  <!-- Brands: copy left, logos right -->
  <section class="band band-warm" aria-labelledby="brands-title">
    <div class="container duo">
      <div class="duo-copy">
        <h2 id="brands-title" class="h2">Every major brand, side by side.</h2>
        <p class="duo-text">
          Compare all the latest devices, from dedicated intrinsically safe handsets to Zone 1 certified iPhone cases
          and conversions.
        </p>
        <a class="arrow-link" href={FIND_PHONES.href}>See all phones <Icon name="arrow-right" /></a>
      </div>
      <ul class="logo-grid" aria-label={`Brands we compare: ${brandList.join(', ')}`}>
        {brands.map((b) => (
          <li class="logo-tile">
            {b.img && b.badge ? (
              <span class="logo-badge" style={`--badge: ${b.badge}`}>
                <img
                  src={b.img.src}
                  width={b.img.width}
                  height={b.img.height}
                  alt={b.name}
                  loading="lazy"
                  style={`--scale: ${b.scale.toFixed(2)}`}
                />
              </span>
            ) : b.img ? (
              <img
                src={b.img.src}
                width={b.img.width}
                height={b.img.height}
                alt={b.name}
                loading="lazy"
                style={`--scale: ${b.scale.toFixed(2)}`}
              />
            ) : (
              <span class="logo-text">{b.name}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Head-to-head: visual left, copy right -->
  <section class="band band-white" aria-labelledby="compare-title">
    <div class="container duo duo-flip">
      <a class="matchup" href={`/compare/${featured.slug}/`} aria-label={`Read the comparison: ${featured.h1}`}>
        {pair.map((p, i) => (
          <span class="matchup-photo" style={`grid-column: ${i * 2 + 1}`}>
            {p.src && <img src={p.src} alt="" width="360" height="360" loading="lazy" />}
          </span>
        ))}
        <span class="matchup-vs" aria-hidden="true">vs</span>
      </a>
      <div class="duo-copy">
        <h2 id="compare-title" class="h2">Compare phones head to head.</h2>
        <p class="duo-text">The verdict, the differences that decide it and the full specifications, side by side.</p>
        <div class="duo-actions">
          <a class="btn btn-primary" href="/compare/">Compare phones <Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- How we compare -->
  <section class="band band-warm" aria-labelledby="principles-title">
    <div class="container principles">
      <div>
        <h2 id="principles-title" class="h2">Facts first, for every brand.</h2>
      </div>
      <ul class="principle-list">
        {principles.map((p) => (
          <li class="principle">
            <span class="icon-badge"><Icon name={p.icon} /></span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Guides -->
  <section class="band band-white" aria-labelledby="insights-title">
    <div class="container">
      <h2 id="insights-title" class="h2">Practical guidance, at your pace.</h2>
      <ul class="insight-grid">
        {insights.map((p) => (
          <li>
            <a class="insight" href={p.href}>
              <Image src={p.img} alt={p.alt} widths={[400, 800]} sizes="(min-width: 56rem) 33vw, 100vw" />
              <h3>{p.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band band-warm" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <div>
        <h2 id="faq-title" class="h2">Hazardous-area phones, explained.</h2>
      </div>
      <div class="faq-list">
        {faq.map((f) => (
          <details class="faq">
            <summary>
              <h3>{f.q}</h3>
              <Icon name="chevron-down" />
            </summary>
            <div class="faq-answer">
              <p>{f.a}</p>
              {f.link && <a class="arrow-link" href={f.link.href}>{f.link.label} <Icon name="arrow-right" /></a>}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

