---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import CostCalculator from '../../components/guides/CostCalculator.astro';
import { SITE, CONTACT, FIND_PHONES } from '../../config/site';
import { GUIDE_PAGES, type GuidePage } from '../../data/guide-pages';
import { BEST_PAGES } from '../../data/best-pages';
import { COMPARE_PAGES } from '../../data/compare-pages';
import { externalLink, pageSlug } from '../../lib/links';
import { processGuideHtml } from '../../lib/guide-html';
import { guidePhotos } from '../../lib/guide-images';
import { Image, getImage } from 'astro:assets';

export const getStaticPaths = (() => GUIDE_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } }))) satisfies GetStaticPaths;

const { page } = Astro.props as { page: GuidePage };
const url = `${SITE.url}/guides/${page.slug}/`;
const utmContent = pageSlug(Astro.url.pathname);

const targets = {
  phones: new Set((await getCollection('phones')).map((p) => p.id)),
  best: new Set(BEST_PAGES.map((b) => b.slug)),
  compare: new Set(COMPARE_PAGES.map((c) => c.slug)),
  guides: new Set(GUIDE_PAGES.map((g) => g.slug)),
};
const html = (s: string) => processGuideHtml(s, { page: `/guides/${page.slug}/`, utmContent, targets });

/* The guide's photos are spaced out through the body; the first is also its share image (Open Graph and the Article schema) */
const photos = guidePhotos(page.slug);
const photo = photos[0];

/* Photo n of N goes before the h2 nearest n/(N+1) of the way through the body, to break up the copy */
const CALCULATOR = '<!-- CALCULATOR -->';
const PHOTO = /^<!-- PHOTO (\d+) -->$/;
const withPhotos = (body: string) => {
  const h2s = [...body.matchAll(/<h2[\s>]/g)].map((m) => m.index).filter((i) => i > 0);
  if (h2s.length < photos.length) throw new Error(`/guides/${page.slug}/: ${photos.length} photos but only ${h2s.length} places to put them`);
  const spots: number[] = [];
  photos.forEach((_, n) => {
    const target = (body.length * (n + 1)) / (photos.length + 1);
    const free = h2s.filter((i) => !spots.includes(i));
    spots.push(free.reduce((a, b) => (Math.abs(b - target) < Math.abs(a - target) ? b : a)));
  });
  return spots
    .sort((a, b) => b - a)
    .reduce((out, at, k) => out.slice(0, at) + `<!-- PHOTO ${spots.length - 1 - k} -->` + out.slice(at), body);
};

/* The body is split where the calculator and the photos go; a guide without either renders as one block */
const parts = withPhotos(page.body)
  .split(/(<!-- CALCULATOR -->|<!-- PHOTO \d+ -->)/)
  .map((s) => (s === CALCULATOR ? s : PHOTO.test(s) ? photos[Number(s.match(PHOTO)![1])] : html(s)));
if (parts.filter((s) => s === CALCULATOR).length > 1) throw new Error(`/guides/${page.slug}/: the calculator marker appears more than once`);
const ctaHtml = html(page.cta.html);
const quote = externalLink('https://xshielder.com/get-a-quote', utmContent);

const shareImage = photo ? (await getImage({ src: photo.img, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : SITE.ogImage;

const dateText = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

/* ---------- Structured data ---------- */
const schema = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: page.h1,
    description: page.description,
    url,
    mainEntityOfPage: url,
    inLanguage: 'en',
    datePublished: page.datePublished,
    dateModified: page.dateModified,
    image: new URL(shareImage, SITE.url).href,
    author: { '@id': `${SITE.url}/#organization` },
    publisher: { '@id': `${SITE.url}/#organization` },
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: 'Home', item: `${SITE.url}/` },
      { name: page.navLabel, item: url },
    ].map((b, i) => ({ '@type': 'ListItem', position: i + 1, ...b })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: page.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={page.title} description={page.description} schema={schema} ogImage={shareImage}>
  <section class="guide-hero" aria-labelledby="guide-title">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: page.navLabel, href: '' }]} />
      <p class="eyebrow">Guide</p>
      <h1 id="guide-title">{page.h1}</h1>
      <p class="lead">{page.lead}</p>
      <p class="guide-meta">
        Updated <time datetime={page.dateModified}>{dateText(page.dateModified)}</time>
      </p>
    </div>
  </section>

  <section class="band band-white guide-band" aria-label="Guide">
    <div class="container">
      <div class="guide-body">
        {parts.map((part) =>
          part === CALCULATOR ? (
            <CostCalculator hideTitle />
          ) : typeof part !== 'string' ? (
            <figure class="guide-photo">
              <Image src={part.img} alt={part.alt} widths={[600, 960, 1200]} sizes="(min-width: 64rem) 60rem, 100vw" />
            </figure>
          ) : (
            part.trim() && <div class="guide-prose" set:html={part} />
          ),
        )}
      </div>
    </div>
  </section>

  <!-- Call to action -->
  <section class="band cta" aria-labelledby="cta-title">
    <svg class="cta-contours" viewBox="0 0 600 260" aria-hidden="true" focusable="false" preserveAspectRatio="xMaxYMid slice">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <path d="M420 130c0-48 46-92 104-92s92 40 92 92-38 96-96 96-100-48-100-96Z" />
        <path d="M380 132c0-70 64-128 146-128s126 58 126 128-54 134-136 134-136-64-136-134Z" />
        <path d="M340 134c0-92 82-166 186-166s162 76 162 166-70 172-174 172-174-80-174-172Z" />
        <path d="M300 136c0-114 100-204 226-204s198 94 198 204-86 210-212 210-212-96-212-210Z" />
      </g>
    </svg>
    <div class="container cta-inner">
      <div>
        <p class="eyebrow">{page.cta.kind === 'xshielder' ? 'Xshielder' : 'Impartial advice'}</p>
        <h2 id="cta-title" class="h2">{page.cta.heading}</h2>
        <p class="cta-text" set:html={ctaHtml} />
      </div>
      <div class="cta-actions">
        {page.cta.kind === 'xshielder' ? (
          <>
            <a class="btn btn-light" href={quote.href} rel={quote.rel} target={quote.target}>Get a quote <Icon name="arrow-right" /></a>
            <a class="btn btn-outline-light" href={CONTACT.href}>Ask us for impartial advice</a>
          </>
        ) : (
          <>
            <a class="btn btn-light" href={CONTACT.href}>Ask us for impartial advice <Icon name="arrow-right" /></a>
            <a class="btn btn-outline-light" href={FIND_PHONES.href}>Find phones</a>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {!page.faqInBody && (
  <section id="faq" class="band band-white" aria-labelledby="faq-title">
    <div class="container faq-wrap">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title" class="h2">Frequently asked questions</h2>
      </div>
      <div class="faq">
        {page.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  )}

  <section class="band sources" aria-label="About this guide">
    <div class="container">
      <p>
        Written by the {SITE.name} team and updated on <time datetime={page.dateModified}>{dateText(page.dateModified)}</time>. Always
        check the certificate for your exact model before use. Spotted an error? <a href={CONTACT.href}>Tell us</a> or see the{' '}
        <a href="/disclosure/">disclosure</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .guide-hero {
    padding-block: 0.5rem 3rem;
    background:
      radial-gradient(1200px 600px at 80% -10%, rgb(245 158 11 / 0.06), transparent 60%),
      radial-gradient(1000px 500px at 10% 30%, rgb(34 197 94 / 0.05), transparent 55%),
      var(--paper-grain);
    background-size: auto, auto, 3px 3px;
  }
  .guide-hero .eyebrow { margin-top: 1.5rem; }
  .guide-hero h1 {
    max-width: 52rem;
    font-size: clamp(2rem, 1.5rem + 2.2vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: var(--tracking-hero);
  }
  .guide-hero .lead { max-width: 44rem; margin-top: 1.25rem; }
  .guide-meta { margin-top: 1.25rem; font-size: var(--text-sm); color: var(--color-muted); }

  /* ---------- Body copy (pasted HTML, so the rules are :global inside .guide-prose) ---------- */
  .guide-band { padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) var(--section-y); }
  .guide-body { display: grid; gap: 2rem; max-width: 60rem; }
  .guide-prose { display: grid; gap: 1.1rem; min-width: 0; }
  .guide-prose > :global(*) { max-width: 44rem; }
  .guide-prose > :global(.table-scroll) { max-width: none; }
  .guide-photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .guide-prose :global(h2) {
    margin-top: 1.75rem;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .guide-prose > :global(h2:first-child) { margin-top: 0; }
  .guide-prose :global(h3) { margin-top: 1rem; font-size: var(--text-h3); }
  .guide-prose :global(a) { color: var(--color-forest); text-underline-offset: 3px; }
  .guide-prose :global(a:hover) { text-decoration-thickness: 2px; }
  .guide-prose :global(strong) { color: var(--color-ink); font-weight: 600; }
  .guide-prose :global(ul),
  .guide-prose :global(ol) { display: grid; gap: 0.5rem; padding-left: 1.25rem; }
  .guide-prose :global(ul) { list-style: disc; }
  .guide-prose :global(ol) { list-style: decimal; }

  /* Tables scroll sideways inside their own box on narrow screens, never the page (position: relative, see CLAUDE.md) */
  .guide-prose :global(.table-scroll) {
    position: relative;
    margin-block: 0.5rem;
    overflow-x: auto;
    border: 1px solid var(--color-panel-border);
    border-radius: var(--radius);
    background: var(--color-panel);
    -webkit-overflow-scrolling: touch;
  }
  .guide-prose :global(.table-scroll:focus-visible) { outline-offset: 2px; }
  .guide-prose :global(table) { width: 100%; min-width: 34rem; border-collapse: collapse; font-size: var(--text-sm); }
  .guide-prose :global(th),
  .guide-prose :global(td) { padding: 0.75rem 1rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--color-panel-border); }
  .guide-prose :global(thead th) {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: var(--color-panel-warm);
  }
  .guide-prose :global(tbody td:first-child) { font-weight: 600; color: var(--color-ink); }
  .guide-prose :global(tbody tr:last-child > *) { border-bottom: 0; }
  .guide-prose :global(td a) { color: var(--color-ink); }
  .guide-prose :global(td a:hover) { color: var(--color-forest); }

  /* ---------- CTA panel ---------- */
  .cta {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 3rem + 2vw, 4.5rem);
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-on-dark);
  }
  .cta-contours {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(60%, 40rem);
    height: 100%;
    color: var(--color-on-dark);
    opacity: 0.09;
    pointer-events: none;
  }
  .cta-inner { position: relative; display: grid; gap: 2rem; align-items: center; }
  .cta .eyebrow { color: var(--color-on-dark-muted); }
  .cta h2 { color: var(--color-on-dark); }
  .cta-text { max-width: 38rem; margin-top: 1rem; color: var(--color-on-dark-muted); }
  .cta-text :global(a) { color: var(--color-on-dark); text-underline-offset: 3px; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 1rem; }
  .cta :global(:focus-visible) { outline-color: var(--color-on-dark); }

  /* ---------- FAQ ---------- */
  .faq-wrap { display: grid; gap: 2rem; }
  .faq details { border-bottom: 1px solid var(--color-panel-border); }
  .faq details:first-child { border-top: 1px solid var(--color-panel-border); }
  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 0.75rem;
    color: var(--color-ink);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; flex: none; font-size: 1.25rem; color: var(--color-forest); transition: transform 0.2s ease; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq details p { padding-bottom: 1.25rem; max-width: 42rem; font-size: var(--text-sm); }

  .sources { padding-block: 2.5rem; font-size: var(--text-sm); color: var(--color-muted); }
  .sources a { color: var(--color-forest); }

  @media (min-width: 56rem) {
    .cta-inner { grid-template-columns: minmax(0, 8fr) auto; }
    .faq-wrap { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 3rem; }
  }
</style>
