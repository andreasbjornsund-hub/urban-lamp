---
// Dev-only layout comparison: inset panels vs full-width sections.
// BaseLayout renders it only under astro dev, so none of this reaches the production build.
---

<form class="layout-switcher" aria-label="Layout preview">
  <fieldset>
    <legend>Layout preview <span>(dev only)</span></legend>
    <label><input type="radio" name="layout" value="inset" checked /> Inset panels</label>
    <label><input type="radio" name="layout" value="full" /> Full-width sections</label>
  </fieldset>
</form>

<script is:inline>
  (() => {
    const KEY = 'isp-layout-preview';
    const form = document.querySelector('.layout-switcher');
    const apply = (v) => {
      const input = form.querySelector(`input[value="${v}"]`);
      if (!input) return;
      input.checked = true;
      if (v === 'inset') delete document.documentElement.dataset.layout;
      else document.documentElement.dataset.layout = v;
    };
    let saved = null;
    try { saved = localStorage.getItem(KEY); } catch {}
    if (saved) apply(saved);
    form.addEventListener('change', (e) => {
      apply(e.target.value);
      try { localStorage.setItem(KEY, e.target.value); } catch {}
    });
  })();
</script>

<style is:global>
  /* ---- Full-width sections ---- */

  /* Dot grain only in the hero; the rest of the paper is plain */
  html[data-layout='full'] body { background-image: none; }
  html[data-layout='full'] .hero {
    background-image:
      radial-gradient(1200px 600px at 80% -10%, rgb(245 158 11 / 0.06), transparent 60%),
      radial-gradient(1000px 500px at 10% 30%, rgb(34 197 94 / 0.05), transparent 55%),
      var(--paper-grain);
    background-size: auto, auto, 3px 3px;
  }

  /* Panels become edge-to-edge bands; content keeps the container width */
  html[data-layout='full'] .block { padding-block: 0; }
  html[data-layout='full'] .block > .container {
    max-width: none;
    padding-inline: 0;
  }
  html[data-layout='full'] .panel {
    --band-inline: max(var(--gutter), calc((100% - var(--container)) / 2));
    padding: var(--section-y) var(--band-inline);
    border-width: 1px 0 0;
    border-radius: 0;
    box-shadow: none;
  }
  html[data-layout='full'] .panel-flush { padding-block: 0; }
  html[data-layout='full'] .panel.cta { border-top-color: var(--color-forest); }
  html[data-layout='full'] .block-last { padding-bottom: 0; }
  html[data-layout='full'] .site-footer { border-top: 0; }

  /* ---- Switcher UI ---- */
  .layout-switcher {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 1000;
    padding: 0.75rem 1rem;
    background: #fff;
    border: 1px solid #c9c4b6;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.15);
    font: 13px/1.4 system-ui, sans-serif;
    color: #1f2723;
  }
  .layout-switcher fieldset { margin: 0; padding: 0; border: 0; }
  .layout-switcher legend { margin-bottom: 0.3rem; font-weight: 600; }
  .layout-switcher legend span { font-weight: 400; color: #555e58; }
  .layout-switcher label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.9rem;
    cursor: pointer;
  }
  .layout-switcher input { accent-color: #1e3a2f; margin: 0; }
</style>
