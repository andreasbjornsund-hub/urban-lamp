---
import { decodeMarking } from '../../lib/phones';

interface Props {
  scheme: string;
  marking: string;
  number?: string;
  /** What the certificate covers, when it isn't every version */
  scope?: string;
  /** Number of the note explaining why the marking is unconfirmed */
  flag?: number;
  /** The scheme name is already on the tab above */
  inTab?: boolean;
}

const { scheme, marking, number, scope, flag, inTab } = Astro.props;

const ATMOSPHERE = { G: 'Gas atmospheres', D: 'Dust atmospheres', M: 'Underground mining' } as const;
const EPL_ZONES: Record<string, string> = {
  Ga: 'Zones 0, 1 and 2', Gb: 'Zones 1 and 2', Gc: 'Zone 2',
  Da: 'Zones 20, 21 and 22', Db: 'Zones 21 and 22', Dc: 'Zone 22',
};

// "II 2G Ex db IIC T6 Gb / II 2D Ex tb IIIC T80°C Db" -> one decoded line per atmosphere.
// The protection level (EPL) names the atmosphere and zones; IECEx markings have no ATEX category.
const seen = new Set<string>();
const lines = marking.split(' / ').map((m) => {
  const parts = decodeMarking(m);
  const epl = parts.find((p) => /^[GDM][abc]$/.test(p.token))?.token;
  const category = parts.find((p) => /^([123][GD]|M[12])$/.test(p.token))?.token;
  const medium = (epl?.[0] ?? (category?.startsWith('M') ? 'M' : category?.[1])) as keyof typeof ATMOSPHERE | undefined;
  // Codes such as "II", "Ex" and "ia" mean the same in every line: explain them once
  const explained = parts.filter((p) => p.meaning);
  const fresh = explained.filter((p) => !seen.has(`${p.token}|${p.meaning}`));
  const repeated = explained.filter((p) => seen.has(`${p.token}|${p.meaning}`));
  explained.forEach((p) => seen.add(`${p.token}|${p.meaning}`));
  return {
    parts,
    fresh,
    repeated,
    title: medium ? ATMOSPHERE[medium] : 'Marking',
    zones: epl ? EPL_ZONES[epl] : undefined,
  };
});
---

<div class="decoder">
  <div class="decoder-head">
    <span class="scheme">
      <span class:list={{ 'visually-hidden': inTab }}>{scheme}</span>
      {flag && <a class="flag" href={`#note-${flag}`}>Unconfirmed<span class="visually-hidden">: see note</span> {flag}</a>}
    </span>
    {number && <span class="cert-no">Certificate {number}</span>}
    {scope && <span class="cert-scope">{scope}</span>}
  </div>
  {lines.map(({ parts, fresh, repeated, title, zones }) => (
    <div class="decoder-line">
      <h4 class="line-title">
        {title}
        {zones && <span class="line-zones">{zones}</span>}
      </h4>
      <p class="marking" aria-label={`Marking: ${parts.map((p) => p.token).join(' ')}`}>
        {parts.map((p) => (
          <span class="token" title={p.meaning || undefined}>{p.token}</span>
        ))}
      </p>
      <dl class="parts">
        {fresh.map((p) => (
          <div>
            <dt><code>{p.token}</code> <span>{p.label}</span></dt>
            <dd>{p.meaning}</dd>
          </div>
        ))}
      </dl>
      {repeated.length > 0 && (
        <p class="as-above">
          {repeated.map((p) => <code>{p.token}</code>)} as above.
        </p>
      )}
    </div>
  ))}
</div>

<style>
  .decoder {
    border: 1px solid var(--color-panel-border);
    border-radius: var(--radius);
    background: var(--color-panel);
    overflow: hidden;
  }
  .decoder-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--color-panel-border);
    background: var(--color-panel-warm);
    font-size: var(--text-sm);
  }
  .scheme { font-weight: 600; color: var(--color-ink); }
  .cert-no { color: var(--color-muted); font-family: var(--font-mono); font-size: 0.8125rem; }
  .cert-scope { flex-basis: 100%; color: var(--color-muted); font-size: 0.8125rem; }

  .decoder-line { padding: 1.25rem; }
  .decoder-line + .decoder-line { border-top: 1px dashed var(--color-panel-border); }

  .line-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.75rem;
    font: 600 var(--text-sm) / 1.3 var(--font-sans);
    color: var(--color-ink);
  }
  .line-zones { font-weight: 500; color: var(--color-muted); }

  .as-above { margin-top: 0.75rem; font-size: var(--text-sm); color: var(--color-muted); }
  .as-above code {
    margin-right: 0.3rem;
    font-family: var(--font-mono);
    color: var(--color-forest);
  }

  .marking {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }
  .token {
    padding: 0.3rem 0.55rem;
    border-radius: var(--radius-sm);
    background: var(--color-icon-bg);
    color: var(--color-forest);
    font: 500 0.9375rem / 1.2 var(--font-mono);
  }

  .parts { display: grid; gap: 0.6rem; margin: 0; }
  .parts div { display: grid; gap: 0.1rem; }
  .parts dt { font-size: var(--text-sm); font-weight: 600; color: var(--color-ink); }
  .parts dt code { font-family: var(--font-mono); color: var(--color-forest); }
  .parts dt span { font-weight: 500; }
  .parts dd { margin: 0; font-size: var(--text-sm); color: var(--color-text); }

  @media (min-width: 48rem) {
    .parts div { grid-template-columns: 13rem 1fr; gap: 1rem; }
  }
</style>
