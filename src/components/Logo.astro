---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a href="/" class:list={['logo', className]}>
  <svg class="logo-mark" viewBox="0 0 172 276" aria-hidden="true" focusable="false">
    <path d="M83 0H22L0 22v232l22 22h61v-28H39a7 7 0 0 1-7-7V35a7 7 0 0 1 7-7h44Z" />
    <path d="M89 0h61l22 22v232l-22 22H89v-28h44a7 7 0 0 0 7-7V35a7 7 0 0 0-7-7H89Z" />
    <rect x="67" y="40" width="38" height="7" rx="3.5" />
  </svg>
  <span class="logo-text">
    <span class="logo-word"><strong>intrinsicallysafephones</strong>.com</span>
    <span class="logo-tagline">ATEX Zone 1 &amp; 2 Devices Compared</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    min-width: 0;
    color: var(--color-ink);
    text-decoration: none;
  }

  .logo-mark {
    flex: none;
    width: auto;
    height: 2.25rem;
    fill: var(--color-logo);
  }

  .logo-text {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .logo-word {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-heading);
    white-space: nowrap;
  }
  .logo-word strong { font-weight: 700; }

  .logo-tagline {
    font-family: var(--font-sans);
    font-size: 0.65625rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-muted);
    white-space: nowrap;
  }

  @media (min-width: 30rem) {
    .logo-mark { height: 2.5rem; }
    .logo-word { font-size: 1.0625rem; }
    .logo-tagline { font-size: 0.6875rem; }
  }
</style>
